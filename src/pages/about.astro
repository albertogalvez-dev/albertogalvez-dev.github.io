---
import Layout from "../layouts/Layout.astro";
import AmbientBg from "../components/AmbientBg.astro";
import TopNav from "../components/TopNav.astro";

const stackGroups = [
  {
    label: "FRONTEND",
    items: [["Angular", "angular.ico"], ["TypeScript", "typescript.ico"], ["React", "react.ico"], ["Next.js", "nextdotjs.ico"], ["Astro", "astro.svg"], ["Vite", "vite.svg"], ["Tailwind CSS", "tailwindcss.ico"]],
  },
  {
    label: "BACKEND Y DATOS", labelEn: "BACKEND & DATA",
    items: [["Symfony", "symfony.ico"], ["PHP", "php.ico"], ["Java", "openjdk.ico"], ["Spring Boot", "springboot.svg"], ["Python", "python.ico"], ["FastAPI", "fastapi.png"], [".NET", "dotnet.ico"], ["PostgreSQL", "postgresql.ico"], ["MySQL", "mysql.ico"], ["Redis", "redis.ico"]],
  },
  {
    label: "PRODUCTO E INFRA", labelEn: "PRODUCT & INFRASTRUCTURE",
    items: [["Docker", "docker.ico"], ["GitHub Actions", "githubactions.ico"], ["OpenAPI", "swagger.ico"], ["WordPress", "wordpress.ico"], ["Payload CMS", "payloadcms.ico"], ["Cloudflare", "cloudflare.ico"]],
  },
];
---

<Layout title="Sobre mí · Alberto Gálvez">
  <AmbientBg />
  <TopNav />

  <main class="about">
    <section class="intro" aria-labelledby="about-title">
      <div class="featured">
        <div class="section-heading">
          <p data-en="FEATURED PROJECTS">PROYECTOS DESTACADOS</p>
          <a href="/deck/" data-en="view all">ver todos ↗</a>
        </div>

        <a href="/projects/convive/" class="project convive">
          <img src="/project-logos/convive.svg" alt="Logo de Convive" />
          <div>
            <small>AIRCURY SUMMER OF CODE · 2026</small>
            <strong>Convive</strong>
            <span data-en="Secure communication and case management for educational institutions.">Comunicación y gestión segura de casos educativos.</span>
          </div>
          <b aria-hidden="true">↗</b>
        </a>

        <a href="/projects/guiacanina/" class="project">
          <img src="/brands/guias-caninas.svg" alt="Logo de Guías Caninas" />
          <div>
            <small data-en="EDITORIAL PRODUCT · 2026">PRODUCTO EDITORIAL · 2026</small>
            <strong>Guías Caninas</strong>
            <span data-en="Traceable content, in-house tools and a headless CMS.">Contenido trazable, herramientas propias y CMS headless.</span>
          </div>
          <b aria-hidden="true">↗</b>
        </a>

        <a href="/projects/serviciosgrx/" class="project">
          <img src="/brands/servicios-grx.png" alt="Logo de Servicios GRX" />
          <div>
            <small data-en="LOCAL DIRECTORY · 2026">DIRECTORIO LOCAL · 2026</small>
            <strong>Servicios GRX</strong>
            <span data-en="Editorial directory of verified professionals in Granada.">Directorio editorial de profesionales verificados en Granada.</span>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
      </div>

      <div class="identity">
        <p class="eyebrow">FULL STACK DEVELOPER</p>
        <h1 id="about-title">Alberto<br />Gálvez</h1>
        <p class="lead" data-en="I build clear, fast and maintainable web products: from the experience of the people who use them to the architecture that supports them.">Construyo productos web claros, rápidos y mantenibles: desde la experiencia de quien los usa hasta la arquitectura que los sostiene.</p>
        <span class="location" data-en="Granada, Spain">Granada, España</span>
      </div>

      <div class="portrait-block">
        <figure class="portrait"><img src="/photos/photo-1.jpg" alt="Alberto Gálvez" /></figure>
        <a class="cv-button" href="/cv.pdf" target="_blank" rel="noreferrer" data-en="View CV <span aria-hidden=&quot;true&quot;>↗</span>">Ver CV <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="resume" aria-label="Professional summary">
      <article class="stack">
        <p class="eyebrow" data-en="TECHNOLOGIES">TECNOLOGÍAS</p>
        <div class="tech-groups">
          {stackGroups.map((group) => (
            <div class="tech-group">
              <p data-en={group.labelEn || group.label}>{group.label}</p>
              <div class="tech-list">
                {group.items.map(([name, icon]) => (
                  <span class="tech"><img src={`/favicons/${icon}`} alt="" loading="lazy" />{name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </article>

      <article>
        <p class="eyebrow" data-en="EDUCATION">FORMACIÓN</p>
        <div class="resume-item education-item">
          <img class="education-logo" src="/education/instituto-foc.png" alt="Logo de Instituto FOC" />
          <div><strong data-en="Web Application Development">Desarrollo de Aplicaciones Web</strong><span>Instituto FOC · 2025 — 2027</span></div>
        </div>
        <div class="resume-item education-item">
          <img class="education-logo" src="/education/ugr.png" alt="Logo de la Universidad de Granada" />
          <div><strong data-en="Business Administration + Law <em>· not completed</em>">ADE + Derecho <em>· no finalizado</em></strong><span>University of Granada · 2017 — 2021</span></div>
        </div>
        <div class="resume-item education-item">
          <img class="education-logo" src="/education/ies-manuel-de-falla.jpg" alt="IES Manuel de Falla" />
          <div><strong data-en="Upper Secondary School, Social Sciences">Bachillerato en Ciencias Sociales</strong><span>IES Manuel de Falla · 2015 — 2017</span></div>
        </div>
        <div class="resume-item education-item">
          <img class="education-logo" src="/education/ies-manuel-de-falla.jpg" alt="IES Manuel de Falla" />
          <div><strong data-en="Compulsory Secondary Education">Educación Secundaria Obligatoria</strong><span>IES Manuel de Falla</span></div>
        </div>
      </article>

      <article>
        <p class="eyebrow" data-en="EXPERIENCE">EXPERIENCIA</p>
        <div class="resume-item experience-item">
          <img class="company-mark company-logo" src="/brands/sempatiza.png" alt="Logo de Sempatiza" />
          <div><strong>Sempatiza</strong><span data-en="Freelance web development and SEO · 2026 — present">Desarrollo web y SEO freelance · 2026 — actualidad</span></div>
        </div>
        <div class="resume-item experience-item">
          <img class="company-mark company-logo" src="/brands/silicoderm.png" alt="Logo de Silicoderm Cosmetics" />
          <div><strong>Silicoderm Cosmetics</strong><span data-en="Logistics supervisor · May 2024 — Dec 2025">Supervisor de logística · May. 2024 — Dic. 2025</span></div>
        </div>
        <div class="resume-item experience-item">
          <img class="company-mark company-logo telepizza-logo" src="/brands/telepizza-red.svg" alt="Logo de Telepizza" />
          <div><strong>Telepizza</strong><span data-en="Management and operations · Aug 2021 — Aug 2025">Gerencia y operaciones · Ago. 2021 — Ago. 2025</span></div>
        </div>
        <div class="resume-item experience-item">
          <img class="company-mark company-logo aft-logo" src="/brands/a-forged-tool.svg" alt="Logo de A Forged Tool" />
          <div><strong>A Forged Tool</strong><span data-en="Logistics operator · Aug 2020 — Apr 2024">Operario logístico · Ago. 2020 — Abr. 2024</span></div>
        </div>
      </article>
    </section>
  </main>
</Layout>

<style is:global>
  body { background: #fafafa !important; color: #181820; --ink: #181820; --ink-soft: #262634; --ink-muted: rgba(24,24,32,.56); }
</style>

<style>
  .about { width: min(1160px, calc(100% - 60px)); margin: 0 auto; padding: 126px 0 54px; }
  .intro { display: grid; grid-template-columns: minmax(330px, 1.15fr) minmax(230px, .72fr) 172px; gap: 42px; align-items: center; padding-bottom: 30px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .section-heading { display: flex; align-items: center; justify-content: space-between; padding-bottom: 9px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .section-heading p, .eyebrow, .project small, .portrait figcaption { margin: 0; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }
  .section-heading a { font-family: var(--mono); font-size: 10px; color: var(--ink-muted); border-bottom: 1px solid currentColor; }
  .project { display: grid; grid-template-columns: 44px minmax(0, 1fr) 18px; gap: 13px; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(24,24,32,.12); transition: padding .2s ease; }
  .project:hover { padding-left: 5px; }
  .project img, .project-mark { width: 44px; height: 44px; border-radius: 11px; object-fit: contain; }
  .project img { background: transparent; box-shadow: none; mix-blend-mode: multiply; }
  .project-mark { display: grid; place-items: center; padding: 0; font-family: var(--mono); font-size: 10px; font-weight: 700; color: #263a62; background: rgba(38,58,98,.08); box-shadow: none; }
  .project strong, .project span { display: block; }
  .project strong { margin: 3px 0; font-size: 15px; letter-spacing: -.02em; }
  .project span { overflow: hidden; color: var(--ink-muted); font-size: 11px; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
  .project b { color: var(--ink-muted); font-size: 18px; font-weight: 400; }
  .identity { align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  .identity h1 { margin: 14px 0 17px; font-size: clamp(42px, 4.6vw, 62px); line-height: .9; letter-spacing: -.07em; }
  .lead { margin: 0; max-width: 300px; color: var(--ink-muted); font-size: 14px; line-height: 1.55; }
  .location { margin-top: 18px; font-family: var(--mono); font-size: 10px; letter-spacing: .08em; color: var(--ink-muted); }
  .portrait-block { display: grid; justify-items: center; gap: 13px; }
  .portrait { width: 154px; height: 188px; margin: 0; overflow: hidden; border-radius: 50%; background: #e7e6e4; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 77% 38%; filter: saturate(.9); }
  .cv-button { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid rgba(24,24,32,.18); border-radius: 999px; color: var(--ink); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .06em; transition: .2s; }
  .cv-button:hover { background: var(--ink); border-color: var(--ink); color: #fff; transform: translateY(-1px); }
  .resume { display: grid; grid-template-columns: 1.6fr .88fr 1.08fr; gap: 36px; padding-top: 29px; }
  .resume article + article { padding-left: 30px; border-left: 1px solid rgba(24,24,32,.12); }
  .tech-groups { display: grid; gap: 12px; margin-top: 14px; }
  .tech-group > p { margin: 0 0 6px; font-family: var(--mono); font-size: 8px; font-weight: 700; letter-spacing: .14em; color: var(--ink-muted); }
  .tech-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tech { display: inline-flex; align-items: center; gap: 6px; padding: 6px 8px; border: 1px solid rgba(24,24,32,.12); border-radius: 7px; font-family: var(--mono); font-size: 9px; color: var(--ink-muted); }
  .tech img { width: 13px; height: 13px; }
  .resume-item { margin-top: 16px; }
  .resume-item strong, .resume-item span { display: block; }
  .resume-item strong { font-size: 13px; letter-spacing: -.015em; }
  .resume-item strong em { color: var(--ink-muted); font-style: normal; font-weight: 400; }
  .resume-item span { margin-top: 4px; color: var(--ink-muted); font-size: 11px; line-height: 1.45; }
  .education-item { display: grid; grid-template-columns: 29px minmax(0, 1fr); gap: 9px; align-items: start; }
  .education-logo { width: 29px; height: 29px; object-fit: contain; border-radius: 5px; mix-blend-mode: multiply; }
  .experience-item { display: grid; grid-template-columns: 42px 1fr; gap: 9px; align-items: start; }
  .company-mark { display: grid; width: 29px; height: 29px; place-items: center; border-radius: 8px; background: #20202a; color: #fff; font-family: var(--mono); font-size: 11px; font-weight: 700; }
  .company-logo { box-sizing: border-box; padding: 0; background: transparent; border: 0; object-fit: contain; mix-blend-mode: multiply; }
  .company-logo.aft-logo { width: 40px; height: 27px; mix-blend-mode: normal; }
  .company-logo.telepizza-logo { width: 40px; height: 26px; mix-blend-mode: normal; }
  @media (max-width: 940px) { .about { width: min(760px, calc(100% - 40px)); }.intro { grid-template-columns: 1fr 180px; gap: 28px; }.identity { grid-column: 1; grid-row: 1; }.featured { grid-column: 1 / -1; grid-row: 2; }.portrait-block { grid-column: 2; grid-row: 1; }.resume { grid-template-columns: 1.2fr 1fr; }.resume article:last-child { grid-column: 1 / -1; padding-left: 0; border-left: 0; border-top: 1px solid rgba(24,24,32,.12); padding-top: 24px; } }
  @media (max-width: 620px) { .about { width: min(100% - 32px, 520px); padding-top: 94px; }.intro { grid-template-columns: 1fr 115px; gap: 21px; }.identity h1 { font-size: 43px; }.lead { font-size: 13px; }.portrait { width: 105px; height: 128px; }.cv-button { padding: 6px 8px; font-size: 8px; }.featured { margin-top: 5px; }.project { grid-template-columns: 40px minmax(0, 1fr) 15px; gap: 10px; }.project img, .project-mark { width: 40px; height: 40px; }.project span { font-size: 10px; }.resume { grid-template-columns: 1fr; gap: 25px; }.resume article + article, .resume article:last-child { padding: 23px 0 0; border-left: 0; border-top: 1px solid rgba(24,24,32,.12); }.tech-list { gap: 6px; } }
</style>
