---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import TopNav from "../../components/TopNav.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((proj, index) => ({
    params: { slug: proj.id },
    props: {
      proj,
      prevProj: projects[(index - 1 + projects.length) % projects.length],
      nextProj: projects[(index + 1) % projects.length],
    },
  }));
}

const { proj, prevProj, nextProj } = Astro.props;
const data = proj.data;
const prev = prevProj.data;
const next = nextProj.data;
const gallery = data.gallery ?? (data.cover ? [data.cover] : []);
const heroImage = gallery[0];
---

<Layout title={`${data.title} · Alberto Gálvez`}>
  <TopNav />
  <main class="project-page" style={`--accent: ${data.accent}; --accent2: ${data.accent2};`}>
    <div class="project-shell">
      <a class="back-link" href="/#projects" data-en="← All projects">← todos los proyectos</a>

      <header class="project-header">
        <div class="case-number" aria-hidden="true">{String(data.order).padStart(2, "0")}</div>
        <div class="heading-copy">
          <div class="project-meta"><span data-en={data.type_en || data.type}>{data.type}</span><i></i><span>{data.year}</span></div>
          <h1 class="title-lockup">
            {data.headerLogo ? (
              <span class="brand-lockup">
                {data.logo && <img class="project-title-logo project-title-favicon" src={data.logo} alt="" aria-hidden="true" />}
                <img class="project-title-logo project-title-logo-wordmark" src={data.headerLogo} alt={data.title} />
              </span>
            ) : (
              <>
                {data.logo && <img class="project-title-logo" src={data.logo} alt="" aria-hidden="true" />}
                <span>{data.title}</span>
              </>
            )}
          </h1>
          {data.tagline && <p class="tagline" data-en={data.tagline_en || data.tagline}>{data.tagline}</p>}
        </div>
        <div class="header-actions">
          {data.demo && <a class="action action-primary" href={data.demo} target="_blank" rel="noreferrer"><span data-en="Open site">Abrir web</span><span aria-hidden="true">↗</span></a>}
          {data.repo && <a class="action" href={data.repo} target="_blank" rel="noreferrer"><span data-en="Source code">Código</span><span aria-hidden="true">↗</span></a>}
        </div>
      </header>

      <section class="project-intro" aria-label="Resumen del proyecto">
        <p data-en={data.summary_en || data.summary}>{data.summary}</p>
        <span class="intro-note" data-en="Case study">Caso de estudio</span>
      </section>

      {heroImage && (
        <section class="hero-screen" data-carousel>
          <div class="screen-bar">
            <span class="screen-dots" aria-hidden="true"><b></b><b></b><b></b></span>
            <span class="screen-label" data-en="Product overview">Vista de producto</span>
            <span class="screen-tools">
              <button class="carousel-button" type="button" data-carousel-prev aria-label="Captura anterior">←</button>
              <span class="screen-index" data-carousel-index>01 / {String(gallery.length).padStart(2, "0")}</span>
              <button class="carousel-button" type="button" data-carousel-next aria-label="Captura siguiente">→</button>
            </span>
          </div>
          <div class="carousel-track">
            {gallery.map((img, index) => (
              <div class:list={["carousel-slide", { "is-active": index === 0 }]} data-carousel-slide aria-hidden={index === 0 ? "false" : "true"}>
                <Image src={img} alt={`Vista de ${data.title} ${index + 1}`} widths={[900, 1440, 1800]} sizes="(max-width: 900px) 100vw, 1120px" quality={100} loading={index === 0 ? "eager" : "lazy"} />
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="case-grid" aria-label="Detalles del proyecto">
        <article class="case-section">
          <span class="section-kicker">01 — <span data-en="Context">Contexto</span></span>
          <h2 data-en="The challenge">El reto</h2>
          <p data-en={data.problem_en || data.problem}>{data.problem}</p>
        </article>
        <article class="case-section">
          <span class="section-kicker">02 — <span data-en="Approach">Enfoque</span></span>
          <h2 data-en="What I built">Qué construí</h2>
          <p data-en={data.build_en || data.build}>{data.build}</p>
        </article>
        <article class="case-section stack-section">
          <span class="section-kicker">03 — Stack</span>
          <ul class="stack-list">{data.stack.map((tech) => <li>{tech}</li>)}</ul>
        </article>
      </section>

      <footer class="project-footer">
        <nav class="case-navigation" aria-label="Navegación entre proyectos">
          <a class="case-link case-link-prev" href={`/projects/${prevProj.id}/`} style={`--case-accent: ${prev.accent};`}>
            <span class="section-kicker" data-en="Previous case">Caso anterior</span><strong><i aria-hidden="true">←</i>{prev.title}</strong>
          </a>
          <span class="case-divider" aria-hidden="true"></span>
          <a class="case-link case-link-next" href={`/projects/${nextProj.id}/`} style={`--case-accent: ${next.accent};`}>
            <span class="section-kicker" data-en="Next case">Siguiente caso</span><strong>{next.title}<i aria-hidden="true">→</i></strong>
          </a>
        </nav>
        <a class="contact-link" href="mailto:albertogalvezde0@gmail.com" data-en="Talk about a project →">Hablemos de un proyecto →</a>
      </footer>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const label = carousel.querySelector<HTMLElement>("[data-carousel-index]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (slides.length < 2 || !label || !previous || !next) return;

    let active = 0;
    let timer: number | undefined;
    const render = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === active;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
      label.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
    };
    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => {
      stop();
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        timer = window.setInterval(() => render(active + 1), 5000);
      }
    };
    previous.addEventListener("click", () => { render(active - 1); start(); });
    next.addEventListener("click", () => { render(active + 1); start(); });
    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", start);
    render(0);
    start();
  });
</script>

<style is:global>
  body { background: #f7f7f5 !important; color: #171720 !important; --ink: #171720; --ink-muted: rgba(23,23,32,.58); --ink-soft: rgba(23,23,32,.82); }
</style>

<style>
  .project-page { min-height: 100vh; position: relative; overflow: hidden; }
  .project-page::before { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none; background-image: radial-gradient(rgba(21,21,31,.14) .7px,transparent .8px),radial-gradient(circle at 14% 24%,color-mix(in srgb,var(--accent) 12%,transparent),transparent 27%),radial-gradient(circle at 86% 70%,color-mix(in srgb,var(--accent2) 10%,transparent),transparent 30%); background-size: 13px 13px,auto,auto; opacity: .5; }
  .project-shell { width: min(1120px,calc(100% - 48px)); margin: 0 auto; padding: 126px 0 84px; }
  .back-link,.section-kicker,.project-meta,.screen-label,.screen-index,.intro-note,figcaption { font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .back-link { color: rgba(23,23,32,.56); transition: color .2s ease,transform .2s ease; }.back-link:hover { color: var(--accent); transform: translateX(-3px); }
  .project-header { display:grid; grid-template-columns:108px minmax(0,1fr) auto; gap:24px; align-items:end; padding:46px 0 28px; border-bottom:1px solid rgba(23,23,32,.16); }
  .case-number { font:500 clamp(56px,7vw,86px)/.76 var(--mono); letter-spacing:-.1em; color:color-mix(in srgb,var(--accent) 78%,#171720); }
  .project-meta { display:flex; align-items:center; gap:9px; color:rgba(23,23,32,.56); margin-bottom:15px; }.project-meta i { width:4px; height:4px; border-radius:50%; background:var(--accent); }
  h1 { margin:0; font:700 clamp(48px,7vw,88px)/.88 var(--sans); letter-spacing:-.065em; }.title-lockup { display:block; }.brand-lockup { display:flex; align-items:center; gap:clamp(12px,1.8vw,20px); }.project-title-logo { width:clamp(52px,5.8vw,76px); height:clamp(52px,5.8vw,76px); flex:0 0 auto; object-fit:contain; }.project-title-favicon { width:clamp(58px,6.2vw,82px); height:clamp(58px,6.2vw,82px); }.project-title-logo-wordmark { width:clamp(210px,29vw,350px); height:clamp(68px,8.5vw,103px); object-position:left center; }.tagline { margin:16px 0 0; max-width:650px; font:400 clamp(16px,1.75vw,22px)/1.35 var(--sans); letter-spacing:-.02em; color:rgba(23,23,32,.64); }
  .header-actions { display:flex; gap:8px; padding-bottom:5px; }.action { display:inline-flex; gap:8px; align-items:center; padding:10px 13px; border:1px solid rgba(23,23,32,.18); border-radius:999px; color:#171720; font:600 11px var(--mono); letter-spacing:.05em; transition:transform .2s ease,background .2s ease; white-space:nowrap; }.action:hover { transform:translateY(-2px); background:#fff; }.action-primary { border-color:var(--accent); background:var(--accent); color:#fff; }.action-primary:hover { background:color-mix(in srgb,var(--accent) 86%,#000); }
  .project-intro { display:flex; justify-content:space-between; gap:28px; padding:27px 0 35px; }.project-intro p { margin:0; max-width:735px; font:400 17px/1.55 var(--sans); letter-spacing:-.012em; color:rgba(23,23,32,.76); }.intro-note { padding-top:5px; color:color-mix(in srgb,var(--accent) 78%,#171720); white-space:nowrap; }
  .hero-screen { overflow:hidden; border:1px solid rgba(23,23,32,.18); border-radius:8px; background:#fff; box-shadow:0 24px 64px color-mix(in srgb,var(--accent) 16%,transparent); }.screen-bar { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; min-height:38px; padding:0 13px; border-bottom:1px solid rgba(23,23,32,.12); background:#fafafa; }.screen-dots { display:flex; gap:5px; }.screen-dots b { width:6px; height:6px; border-radius:50%; background:rgba(23,23,32,.2); }.screen-dots b:first-child { background:var(--accent); }.screen-label { color:rgba(23,23,32,.6); }.screen-tools { display:flex; align-items:center; justify-content:flex-end; gap:8px; }.screen-index { color:rgba(23,23,32,.42); min-width:40px; text-align:center; }.carousel-button { display:grid; width:20px; height:20px; place-items:center; padding:0; border:1px solid rgba(23,23,32,.16); border-radius:3px; color:rgba(23,23,32,.65); font-size:13px; line-height:1; transition:background .2s,color .2s; }.carousel-button:hover { background:var(--accent); border-color:var(--accent); color:#fff; }.carousel-track { position:relative; aspect-ratio:16 / 9; overflow:hidden; background:color-mix(in srgb,var(--accent) 9%,#f5f7fa); }.carousel-slide { position:absolute; inset:0; display:grid; place-items:center; opacity:0; visibility:hidden; transform:translateX(1.25%); transition:opacity .45s ease,transform .45s ease,visibility .45s step-end; }.carousel-slide.is-active { opacity:1; visibility:visible; transform:translateX(0); transition:opacity .45s ease,transform .45s ease; }.carousel-slide :global(img) { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .case-grid { display:grid; grid-template-columns:1.05fr 1.05fr .9fr; gap:0; margin:52px 0 68px; border-top:1px solid rgba(23,23,32,.16); border-bottom:1px solid rgba(23,23,32,.16); }.case-section { min-height:230px; padding:27px 26px 30px 0; }.case-section+.case-section { padding-left:27px; border-left:1px solid rgba(23,23,32,.16); }.section-kicker { color:color-mix(in srgb,var(--accent) 78%,#171720); }.case-section h2 { margin:28px 0 10px; font:650 22px/1.05 var(--sans); letter-spacing:-.035em; }.case-section p { margin:0; font:400 14px/1.62 var(--sans); color:rgba(23,23,32,.68); }.stack-list { display:flex; flex-wrap:wrap; gap:7px; margin:27px 0 0; padding:0; list-style:none; }.stack-list li { padding:7px 9px; border:1px solid color-mix(in srgb,var(--accent) 28%,rgba(23,23,32,.14)); border-radius:4px; font:600 10px var(--mono); color:rgba(23,23,32,.74); }
  .screens-section { margin-bottom:75px; }.section-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; }.screen-count { font:600 11px var(--mono); color:rgba(23,23,32,.47); }.screens-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }.shot { margin:0; overflow:hidden; border:1px solid rgba(23,23,32,.16); border-radius:7px; background:#fff; }.shot :global(img) { display:block; width:100%; height:auto; transition:transform .35s ease; }.shot:hover :global(img) { transform:scale(1.018); }.shot figcaption { display:flex; gap:8px; padding:11px 13px; border-top:1px solid rgba(23,23,32,.1); color:rgba(23,23,32,.5); }.shot figcaption span { color:rgba(23,23,32,.7); }
  .project-footer { position:relative; display:flex; justify-content:center; align-items:center; min-height:104px; padding-top:24px; border-top:1px solid rgba(23,23,32,.16); }.case-navigation { display:grid; grid-template-columns:minmax(150px,1fr) 1px minmax(150px,1fr); align-items:center; gap:26px; width:min(100%,520px); }.case-divider { width:1px; height:52px; background:rgba(23,23,32,.16); }.case-link { display:flex; flex-direction:column; gap:9px; color:#171720; }.case-link-prev { align-items:flex-end; text-align:right; }.case-link-next { align-items:flex-start; text-align:left; }.case-link strong { display:flex; align-items:center; gap:9px; font:650 23px/1 var(--sans); letter-spacing:-.04em; white-space:nowrap; }.case-link strong i { display:grid; width:28px; height:28px; place-items:center; border-radius:50%; background:var(--case-accent); color:#fff; font:500 17px/1 var(--sans); font-style:normal; transition:transform .2s ease; }.case-link-prev:hover i { transform:translateX(-3px); }.case-link-next:hover i { transform:translateX(3px); }.contact-link { position:absolute; right:0; bottom:31px; color:rgba(23,23,32,.62); font:600 11px var(--mono); letter-spacing:.07em; }.contact-link:hover { color:var(--accent); }
  @media (max-width:840px) { .project-header { grid-template-columns:76px 1fr; }.header-actions { grid-column:2; }.case-grid { grid-template-columns:1fr 1fr; }.stack-section { grid-column:1/-1; min-height:auto; border-left:0!important; border-top:1px solid rgba(23,23,32,.16); padding-left:0!important; }.stack-list { margin-top:18px; }.project-footer { align-items:center; flex-direction:column; padding-bottom:40px; }.contact-link { position:static; margin-top:24px; } }
  @media (max-width:580px) { .project-shell { width:min(100% - 32px,560px); padding-top:96px; }.project-header { grid-template-columns:54px 1fr; gap:16px; padding-top:34px; }.case-number { font-size:47px; }.header-actions { grid-column:1/-1; }.project-intro { display:block; }.intro-note { display:block; margin-top:15px; }.case-grid,.screens-grid { grid-template-columns:1fr; }.case-section,.case-section+.case-section { min-height:auto; padding:24px 0; border-left:0; border-top:1px solid rgba(23,23,32,.16); }.case-section:first-child { border-top:0; }.stack-section { grid-column:auto; }.hero-screen { border-radius:6px; }.screen-label { font-size:8px; }.case-navigation { gap:13px; }.case-link strong { font-size:16px; }.case-link strong i { width:24px; height:24px; font-size:15px; }.case-divider { height:43px; } }
</style>
