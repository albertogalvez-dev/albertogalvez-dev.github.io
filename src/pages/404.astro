---
import Layout from "../layouts/Layout.astro";
import AmbientBg from "../components/AmbientBg.astro";
import TopNav from "../components/TopNav.astro";
---

<Layout title="404 · Alberto Gálvez">
  <AmbientBg />

  <TopNav />

  <main class="not-found">
    <p class="error-code" aria-hidden="true">404</p>

    <h1 class="error-title" data-en="This page doesn't exist.">
      Esta página no existe.
    </h1>

    <p class="error-lead" data-en="Maybe the link you followed is broken — or maybe I broke something while shipping. Either way, here are working paths:">
      Probablemente el enlace está roto — o algo rompí yo shipeando. En cualquier caso, por aquí sí hay sitio:
    </p>

    <div class="error-actions">
      <a class="cta-primary" href="/#projects">
        <span data-en="See projects">Ver proyectos</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
      <a class="cta-ghost" href="/about/" data-en="About me">Sobre mí</a>
      <a class="cta-ghost" href="/" data-en="Home">Inicio</a>
    </div>
  </main>
</Layout>

<style is:global>
  body {
    background: #fafafa !important;
    color: #1a1a22 !important;
    --ink: #1a1a22;
    --ink-muted: rgba(20, 20, 30, 0.55);
    --ink-soft: rgba(20, 20, 30, 0.78);
  }
</style>

<style>
  /* === MAIN === */
  .not-found {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 48px clamp(24px, 6vw, 56px) 80px;
    text-align: center;
  }

  .error-code {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(120px, 28vw, 240px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(
      135deg,
      rgba(20, 20, 30, 0.15),
      rgba(20, 20, 30, 0.05)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: -20px;
  }

  .error-title {
    margin: 0 0 16px;
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
  }

  .error-lead {
    margin: 0 0 40px;
    font-family: var(--sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.55;
    color: rgba(20, 20, 30, 0.65);
    max-width: 520px;
  }

  .error-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: center;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: 999px;
    background: #1a1a22;
    color: #fafafa;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    transition: background 200ms ease, transform 200ms ease;
  }
  .cta-primary:hover {
    background: #0a0a0c;
    transform: translateY(-1px);
  }
  .cta-primary svg { transition: transform 200ms ease; }
  .cta-primary:hover svg { transform: translateX(3px); }

  .cta-ghost {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: rgba(20, 20, 30, 0.6);
    padding: 13px 4px;
    transition: color 200ms ease;
  }
  .cta-ghost:hover { color: var(--ink, #1a1a22); }

</style>
