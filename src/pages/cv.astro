---
import Layout from "../layouts/Layout.astro";
import AmbientBg from "../components/AmbientBg.astro";
import TopNav from "../components/TopNav.astro";

const versions = [
  {
    href: "/cv/es/",
    label: "CV · Español",
    labelEn: "CV · Spanish",
    note: "Versión con diseño. Para enviar por email o compartir directamente.",
    noteEn: "Designed version. To send by email or share directly.",
    primary: true,
  },
  {
    href: "/cv/en/",
    label: "CV · English",
    labelEn: "CV · English",
    note: "Versión con diseño, en inglés.",
    noteEn: "Designed version, in English.",
    primary: true,
  },
  {
    href: "/cv/es-ats/",
    label: "CV ATS · Español",
    labelEn: "ATS CV · Spanish",
    note: "Una columna, texto plano. Para portales de empleo (Workday, Greenhouse…).",
    noteEn: "Single column, plain text. For job portals (Workday, Greenhouse…).",
  },
  {
    href: "/cv/en-ats/",
    label: "CV ATS · English",
    labelEn: "ATS CV · English",
    note: "Una columna, texto plano, en inglés.",
    noteEn: "Single column, plain text, in English.",
  },
];
---

<Layout title="CV · Alberto Gálvez">
  <AmbientBg />
  <TopNav />

  <main class="cv">
    <header class="cv-head">
      <p class="eyebrow" data-en="CURRICULUM">CURRÍCULUM</p>
      <h1>Alberto Gálvez Aguado</h1>
      <p class="lead" data-en="Full Stack Developer · Junior — pick the format you need.">Full Stack Developer · Junior — elige el formato que necesitas.</p>
    </header>

    <ul class="grid">
      {versions.map((v) => (
        <li class:list={["card", { primary: v.primary }]}>
          <a href={v.href} target="_blank" rel="noreferrer">
            <span class="card-label" data-en={v.labelEn}>{v.label}</span>
            <span class="card-note" data-en={v.noteEn}>{v.note}</span>
            <span class="card-cta" aria-hidden="true">PDF ↗</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="back" href="/about/" data-en="← Back to about">← Volver a sobre mí</a>
  </main>
</Layout>

<style is:global>
  body { background: #fafafa !important; color: #181820; --ink: #181820; --ink-muted: rgba(24,24,32,.56); }
</style>

<style>
  .cv { width: min(720px, calc(100% - 48px)); margin: 0 auto; padding: 132px 0 64px; }
  .cv-head { padding-bottom: 26px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .eyebrow { margin: 0; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }
  .cv-head h1 { margin: 12px 0 10px; font-size: clamp(34px, 5vw, 48px); line-height: .95; letter-spacing: -.05em; }
  .lead { margin: 0; color: var(--ink-muted); font-size: 14px; }
  .grid { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .card a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 20px; border: 1px solid rgba(24,24,32,.14); border-radius: 14px; background: #fff; color: inherit; text-decoration: none; transition: .18s; }
  .card a:hover { border-color: var(--ink); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(24,24,32,.08); }
  .card.primary a { border-color: rgba(79,70,229,.4); }
  .card-label { font-size: 15px; font-weight: 700; letter-spacing: -.01em; }
  .card-note { flex: 1; color: var(--ink-muted); font-size: 12px; line-height: 1.5; }
  .card-cta { margin-top: 4px; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; color: #4f46e5; }
  .back { display: inline-block; margin-top: 28px; font-family: var(--mono); font-size: 11px; color: var(--ink-muted); border-bottom: 1px solid currentColor; }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .cv { padding-top: 104px; } }
</style>
