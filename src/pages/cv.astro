---
import Layout from "../layouts/Layout.astro";
import AmbientBg from "../components/AmbientBg.astro";
import TopNav from "../components/TopNav.astro";

const groups = [
  {
    label: "CON DISEÑO",
    labelEn: "DESIGNED",
    meta: "PDF · 1 página",
    metaEn: "PDF · 1 page",
    rows: [
      {
        href: "/cv/es/",
        mark: "ES",
        title: "Currículum · Español",
        titleEn: "Résumé · Spanish",
        note: "Para enviar por email, adjuntar o compartir el enlace.",
        noteEn: "To email, attach, or share as a link.",
      },
      {
        href: "/cv/en/",
        mark: "EN",
        title: "Résumé · English",
        titleEn: "Résumé · English",
        note: "La misma maqueta, en inglés.",
        noteEn: "The same layout, in English.",
      },
    ],
  },
  {
    label: "FORMATO ATS",
    labelEn: "ATS FORMAT",
    meta: "PDF · texto plano",
    metaEn: "PDF · plain text",
    rows: [
      {
        href: "/cv/es-ats/",
        mark: "ES",
        title: "Currículum ATS · Español",
        titleEn: "ATS résumé · Spanish",
        note: "Una columna, sin gráficos. Para portales tipo Workday o Greenhouse.",
        noteEn: "Single column, no graphics. For portals like Workday or Greenhouse.",
      },
      {
        href: "/cv/en-ats/",
        mark: "EN",
        title: "ATS résumé · English",
        titleEn: "ATS résumé · English",
        note: "Una columna, texto plano, en inglés.",
        noteEn: "Single column, plain text, in English.",
      },
    ],
  },
];
---

<Layout
  title="CV · Alberto Gálvez Aguado"
  description="Currículum de Alberto Gálvez Aguado — Full Stack Developer · Junior. Versión con diseño y versión ATS, en español e inglés."
  ogImage="/og-cv-v6.jpg"
>
  <AmbientBg />
  <TopNav showCv={false} />

  <main class="cv">
    <header class="cv-head">
      <p class="eyebrow" data-en="CURRICULUM VITAE">CURRÍCULUM</p>
      <h1>Alberto Gálvez Aguado</h1>
      <p class="lead" data-en="Full Stack Developer · Junior. Pick a language and format.">
        Full Stack Developer · Junior. Elige idioma y formato.
      </p>
    </header>

    <div class="cv-formats">
      {groups.map((group) => (
        <section class="cv-group">
          <div class="section-heading">
            <p data-en={group.labelEn}>{group.label}</p>
            <span data-en={group.metaEn}>{group.meta}</span>
          </div>
          {group.rows.map((row) => (
            <a class="row" href={row.href}>
              <span class="mark">{row.mark}</span>
              <div>
                <strong data-en={row.titleEn}>{row.title}</strong>
                <span data-en={row.noteEn}>{row.note}</span>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </section>
      ))}
    </div>

    <p class="foot" data-en="Each link opens a résumé adapted to your screen; the “Download” button saves the PDF with a clean file name.">
      Cada enlace abre el currículum adaptado a tu pantalla; el botón «Descargar» guarda el PDF con el nombre correcto.
    </p>
    <a class="back" href="/" data-en="← Back to home">← Volver al inicio</a>
  </main>
</Layout>

<style is:global>
  body { background: #fafafa !important; color: #181820; --ink: #181820; --ink-soft: #262634; --ink-muted: rgba(24,24,32,.56); }
</style>

<style>
  .cv { width: min(920px, calc(100% - 48px)); margin: 0 auto; padding: 48px 0 80px; }

  .cv-head { padding-bottom: 24px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .eyebrow { margin: 0; font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }
  .cv-head h1 { margin: 13px 0 12px; font-size: clamp(38px, 5vw, 56px); line-height: 1.08; letter-spacing: -.06em; }
  .lead { margin: 0; max-width: 46ch; color: var(--ink-muted); font-size: 14px; line-height: 1.55; }

  .cv-group { margin-top: 8px; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 30px; padding-bottom: 9px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .section-heading p, .section-heading span { margin: 0; font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }

  .row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 18px; gap: 14px; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(24,24,32,.12); color: inherit; text-decoration: none; transition: padding .2s ease; }
  .row:hover { padding-left: 5px; }
  .mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: rgba(38,58,98,.08); color: #263a62; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .04em; }
  .row strong { display: block; margin-bottom: 3px; font-size: 15px; letter-spacing: -.02em; }
  .row div > span { display: block; color: var(--ink-muted); font-size: 14px; line-height: 1.5; }
  .row b { color: var(--ink-muted); font-size: 18px; font-weight: 400; }

  .foot { margin: 26px 0 0; color: var(--ink-muted); font-size: 13px; line-height: 1.5; }
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 14px; font-family: var(--mono); font-size: 11px; color: var(--ink-muted); border-bottom: 1px solid currentColor; }

  @media (max-width: 560px) {
    .cv { width: calc(100% - 32px); padding-top: 32px; }
    .cv-head h1 { font-size: 34px; }
    .row { grid-template-columns: 40px minmax(0, 1fr) 15px; gap: 11px; }
    .mark { width: 40px; height: 40px; font-size: 12px; }
  }
  .section-heading { flex-wrap: wrap; gap: 8px 16px; }
  .row { min-height: 88px; }
  .row strong { line-height: 1.4; }
  .cv-formats { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px; }
  .cv-group { min-width: 0; }
  @media (max-width: 680px) { .cv-formats { grid-template-columns: minmax(0,1fr); gap: 0; } }
</style>
