---
import Layout from "../layouts/Layout.astro";
import AmbientBg from "../components/AmbientBg.astro";
import TopNav from "../components/TopNav.astro";

const groups = [
  {
    label: "CON DISEÑO",
    labelEn: "DESIGNED",
    meta: "PDF · 1 página",
    metaEn: "PDF · 1 page",
    rows: [
      {
        href: "/cv/es/",
        mark: "ES",
        title: "Currículum · Español",
        titleEn: "Résumé · Spanish",
        note: "Para enviar por email, adjuntar o compartir el enlace.",
        noteEn: "To email, attach, or share as a link.",
      },
      {
        href: "/cv/en/",
        mark: "EN",
        title: "Résumé · English",
        titleEn: "Résumé · English",
        note: "La misma maqueta, en inglés.",
        noteEn: "The same layout, in English.",
      },
    ],
  },
  {
    label: "FORMATO ATS",
    labelEn: "ATS FORMAT",
    meta: "PDF · texto plano",
    metaEn: "PDF · plain text",
    rows: [
      {
        href: "/cv/es-ats/",
        mark: "ES",
        title: "Currículum ATS · Español",
        titleEn: "ATS résumé · Spanish",
        note: "Una columna, sin gráficos. Para portales tipo Workday o Greenhouse.",
        noteEn: "Single column, no graphics. For portals like Workday or Greenhouse.",
      },
      {
        href: "/cv/en-ats/",
        mark: "EN",
        title: "ATS résumé · English",
        titleEn: "ATS résumé · English",
        note: "Una columna, texto plano, en inglés.",
        noteEn: "Single column, plain text, in English.",
      },
    ],
  },
];
---

<Layout
  title="CV · Alberto Gálvez Aguado"
  description="Currículum de Alberto Gálvez Aguado — Full Stack Developer · Junior. Versión con diseño y versión ATS, en español e inglés."
  ogImage="/og-cv-v4.jpg"
>
  <AmbientBg />
  <TopNav showCv={false} />

  <main class="cv">
    <header class="cv-head">
      <p class="eyebrow" data-en="CURRICULUM VITAE">CURRÍCULUM</p>
      <h1>Alberto Gálvez Aguado</h1>
      <p class="lead" data-en="Full Stack Developer · Junior. Pick a language and format.">
        Full Stack Developer · Junior. Elige idioma y formato.
      </p>
    </header>

    <div class="cv-formats">
      {groups.map((group) => (
        <section class="cv-group">
          <div class="section-heading">
            <p data-en={group.labelEn}>{group.label}</p>
            <span data-en={group.metaEn}>{group.meta}</span>
          </div>
          {group.rows.map((row) => (
            <a class="row" href={row.href}>
              <span class="mark">{row.mark}</span>
              <div>
                <strong data-en={row.titleEn}>{row.title}</strong>
                <span data-en={row.noteEn}>{row.note}</span>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </section>
      ))}
    </div>

    <p class="foot" data-en="Each link opens a viewer; the “Download” button saves the PDF with a clean file name.">
      Cada enlace abre un visor; el botón «Descargar» guarda el PDF con el nombre correcto.
    </p>
    <a class="back" href="/" data-en="← Back to home">← Volver al inicio</a>
  </main>
</Layout>

<style is:global>
  body { background: #fafafa !important; color: #181820; --ink: #181820; --ink-muted: rgba(24,24,32,.56); }
  html, body { height:100%; overflow:hidden; }
</style>

<style>
  .cv { width: min(920px, calc(100% - 48px)); height:100svh; margin: 0 auto; padding: 112px 0 24px; display:flex; flex-direction:column; justify-content:center; overflow:hidden; }

  .cv-head { padding-bottom: 24px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .eyebrow { margin: 0; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }
  .cv-head h1 { margin: 13px 0 12px; font-size: clamp(38px, 5vw, 56px); line-height: .9; letter-spacing: -.06em; }
  .lead { margin: 0; max-width: 46ch; color: var(--ink-muted); font-size: 14px; line-height: 1.55; }

  .cv-formats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; margin-top: 8px; }
  .cv-group { min-width: 0; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 30px; padding-bottom: 9px; border-bottom: 1px solid rgba(24,24,32,.12); }
  .section-heading p, .section-heading span { margin: 0; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .16em; color: var(--ink-muted); }

  .row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 18px; gap: 14px; align-items: center; padding: 15px 0; border-bottom: 1px solid rgba(24,24,32,.12); color: inherit; text-decoration: none; transition: padding .2s ease; }
  .row:hover { padding-left: 5px; }
  .mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: rgba(38,58,98,.08); color: #263a62; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .04em; }
  .row strong { display: block; margin-bottom: 3px; font-size: 15px; letter-spacing: -.02em; }
  .row div > span { display: block; color: var(--ink-muted); font-size: 11px; line-height: 1.4; }
  .row b { color: var(--ink-muted); font-size: 18px; font-weight: 400; }

  .foot { margin: 26px 0 0; color: var(--ink-muted); font-size: 11px; line-height: 1.5; }
  .back { display: inline-block; margin-top: 14px; font-family: var(--mono); font-size: 11px; color: var(--ink-muted); border-bottom: 1px solid currentColor; }

  @media (max-width: 680px) {
    .cv { width:calc(100% - 32px); padding:64px 0 10px; }
    .cv-head { padding-bottom:12px; }
    .cv-head h1 { margin:9px 0 7px; font-size:clamp(25px,7.2vw,31px); line-height:.98; }
    .lead { font-size:11px; line-height:1.35; }
    .cv-formats { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:0; }
    .section-heading { flex-wrap:wrap; gap:3px 6px; margin-top:12px; padding-bottom:6px; }
    .section-heading p,.section-heading span { font-size:7px; letter-spacing:.07em; }
    .row { grid-template-columns:26px minmax(0,1fr); gap:7px; padding:9px 0; }
    .mark { width:26px; height:26px; border-radius:8px; font-size:8px; }
    .row strong { font-size:11px; line-height:1.2; }
    .row div > span { margin-top:3px; font-size:9px; line-height:1.3; }
    .row b { display:none; }
    .foot { margin-top:14px; font-size:10px; line-height:1.35; }
    .back { margin-top:8px; font-size:10px; }
  }
  @media (max-width:380px) {
    .cv { width:calc(100% - 24px); padding-top:58px; }
    .cv-formats { gap:9px; }
    .row { grid-template-columns:22px minmax(0,1fr); gap:5px; padding:7px 0; }
    .mark { width:22px; height:22px; }
    .row strong { font-size:10px; }
    .row div > span { font-size:8px; }
    .foot { font-size:9px; }
  }
</style>
