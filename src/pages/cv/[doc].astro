---
import Layout from "../../layouts/Layout.astro";
import ResumeDocument from "../../components/ResumeDocument.astro";

export function getStaticPaths() {
  return [
    {
      params: { doc: "es" },
      props: {
        file: "/cv-es.pdf",
        name: "Alberto-Galvez-Aguado-CV.pdf",
        title: "CV · Alberto Gálvez Aguado",
      },
    },
    {
      params: { doc: "en" },
      props: {
        file: "/cv-en.pdf",
        name: "Alberto-Galvez-Aguado-CV-EN.pdf",
        title: "CV (English) · Alberto Gálvez Aguado",
      },
    },
    {
      params: { doc: "es-ats" },
      props: {
        file: "/cv-es-ats.pdf",
        name: "Alberto-Galvez-Aguado-CV-ATS.pdf",
        title: "CV ATS · Alberto Gálvez Aguado",
      },
    },
    {
      params: { doc: "en-ats" },
      props: {
        file: "/cv-en-ats.pdf",
        name: "Alberto-Galvez-Aguado-CV-EN-ATS.pdf",
        title: "CV (English, ATS) · Alberto Gálvez Aguado",
      },
    },
  ];
}

const { file, name, title } = Astro.props;
const doc = Astro.params.doc!;
const english = doc.startsWith("en");
---

<Layout title={title} lang={english ? "en" : "es"} description="Currículum de Alberto Gálvez Aguado — Full Stack Developer · Junior." ogImage="/og-cv-v6.jpg">
  <div class="viewer">
    <nav class="bar" aria-label={english ? "Résumé actions" : "Acciones del currículum"}>
      <a class="back" href="/cv/">← {english ? "All formats" : "Todos los formatos"}</a>
      <div class="document-actions">
        <a class="open" href={file} target="_blank" rel="noopener">{english ? "Open PDF ↗" : "Abrir PDF ↗"}</a>
        <a class="dl" href={file} download={name}>↓ {english ? "Download PDF" : "Descargar PDF"}</a>
      </div>
    </nav>
    <ResumeDocument doc={doc} />
  </div>
</Layout>

<style is:global>
  html, body { background: #f0f1f5; color: #18213a; --ink: #18213a; }
</style>

<style>
  .viewer { min-height: 100svh; }
  .bar { position: sticky; top: 0; z-index: 20; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 20px; padding: 12px max(16px, env(safe-area-inset-left)); background: rgba(255,255,255,.96); border-bottom: 1px solid #dfe4ef; backdrop-filter: blur(18px); }
  .bar a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 16px; font: 600 13px/1.4 var(--sans); border-radius: 999px; }
  .document-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .open { border: 1px solid #dfe4ef; }
  .dl { background: #4f46e5; color: #fff; }
  .dl:hover { background: #4038c4; }
  @media (max-width: 560px) {
    .bar { position: relative; padding: 8px 16px 16px; gap: 4px; }
    .back { padding-left: 0 !important; }
    .document-actions { width: 100%; }
    .document-actions a { flex: 1 1 auto; }
  }
</style>
