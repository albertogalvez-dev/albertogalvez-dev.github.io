---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AmbientBg from "../components/AmbientBg.astro";
import PhotosCarousel from "../components/PhotosCarousel.astro";
import TopNav from "../components/TopNav.astro";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Alberto Gálvez · Software Developer">
  <AmbientBg /><PhotosCarousel />
  <TopNav showProjects={false} />
  <main class="deck" id="projects">
    <p class="intro">FULL STACK DEVELOPER</p>
    <div class="deck-filter" role="tablist">
      <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true"><span data-en="All">Todos</span><b>{projects.length}</b></button>
      <button class="filter-btn" data-filter="personal" role="tab" aria-selected="false"><span data-en="Personal">Personales</span><b>{projects.filter(p => p.data.type === "Personal").length}</b></button>
      <button class="filter-btn" data-filter="cliente" role="tab" aria-selected="false"><span data-en="Company">Empresa</span><b>{projects.filter(p => p.data.type === "Cliente").length}</b></button>
      <button class="filter-btn" data-filter="equipo" role="tab" aria-selected="false"><span data-en="Team">Equipo</span><b>{projects.filter(p => p.data.type === "Equipo").length}</b></button>
    </div>
    <div class="deck-stage">
      {projects.map((project, index) => <div class:list={["deck-slot", {"is-active": index === 0}]} data-type={project.data.type === "Cliente" ? "cliente" : project.data.type === "Equipo" ? "equipo" : "personal"}><ProjectCard {...project.data} slug={project.id} /></div>)}
    </div>
    <nav class="deck-nav" aria-label="Navegar proyectos"><button class="nav-prev" aria-label="Proyecto anterior" disabled>‹</button><span><i class="counter-current">1</i> / <i class="counter-total">{projects.length}</i></span><button class="nav-next" aria-label="Siguiente proyecto">›</button></nav>
  </main>
</Layout>
<style is:global>
  html,body{height:100%;overflow:hidden;overscroll-behavior:none}body{background:#fafafa!important;color:#1a1a22!important;--ink:#1a1a22;--ink-muted:rgba(20,20,30,.55);--ink-soft:rgba(20,20,30,.78);--glass-border:rgba(0,0,0,.06);--glass-strong:rgba(0,0,0,.16)}.btn-primary{background:#1a1a22!important;color:#fafafa!important;border-color:#1a1a22!important}.btn-primary:hover{background:#34343d!important;color:#fafafa!important}
</style>
<style>
  .deck { height: 100svh; height: 100dvh; display: grid; grid-template-rows: auto auto minmax(0,280px) auto; justify-items: center; align-content: center; gap: 10px; padding: 96px 20px 16px; }
  .intro { margin: 0; font: 600 11px/1.3 var(--mono); letter-spacing: .28em; color: var(--ink-muted); }
  .deck-filter { display: flex; gap: 4px; padding: 4px; max-width: 100%; border: 1px solid rgba(0,0,0,.06); border-radius: 999px; background: rgba(255,255,255,.55); box-shadow: inset 0 1px rgba(255,255,255,.7),0 4px 14px rgba(20,18,40,.06); backdrop-filter: blur(18px); }
  .filter-btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 14px; border-radius: 999px; font-size: 12px; color: var(--ink-muted); }
  .filter-btn:hover { background: rgba(0,0,0,.04); }
  .filter-btn.is-active { background: #1a1a22; color: #fafafa; }
  .filter-btn b { padding: 2px 7px; border-radius: 999px; background: rgba(0,0,0,.06); font: 500 10px var(--mono); }
  .filter-btn.is-active b { background: rgba(255,255,255,.18); }
  .deck-stage { position: relative; display: grid; width: min(100%,480px); height: 100%; min-height: 0; align-self: center; container-type: size; }
  .deck-slot { grid-area: 1/1; min-height: 0; width: 100%; display: none; }
  .deck-slot.is-active { display: block; }
  .deck-slot[data-hidden] { display: none !important; }
  .deck-nav { display: flex; gap: 12px; align-items: center; font: 500 12px var(--mono); color: var(--ink-muted); }
  .deck-nav button { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--glass-border); border-radius: 50%; font-size: 22px; color: var(--ink-soft); }
  .deck-nav button:hover:not(:disabled) { background: rgba(255,255,255,.45); }
  .deck-nav button:disabled { opacity: .3; cursor: not-allowed; }
  .deck-nav span { min-width: 54px; text-align: center; }
  .deck-nav i { font-style: normal; }
  @media (max-width: 720px) {
    .deck { padding: 80px 12px max(8px,env(safe-area-inset-bottom)); gap: 8px; }
    .intro { font-size: 10px; letter-spacing: .22em; }
    .filter-btn { padding: 8px 8px; gap: 5px; font-size: 11px; }
    .filter-btn b { padding: 2px 5px; }
  }
  @media (max-width: 360px) {
    .deck-filter { gap: 0; }
    .filter-btn { padding: 8px 5px; gap: 3px; font-size: 10px; }
    .filter-btn b { padding: 2px 4px; font-size: 9px; }
  }
  @media (max-height: 600px) and (min-width: 520px) {
    .deck { grid-template-rows: auto minmax(0,220px) auto; padding-top: 66px; gap: 6px; }
    .intro { display: none; }
    .deck-stage { width: min(100%,480px); }
  }
</style>
<script>
  const stage = document.querySelector<HTMLDivElement>(".deck-stage");
  if (stage) {
    const all = [...stage.querySelectorAll<HTMLDivElement>(".deck-slot")];
    const prev = document.querySelector<HTMLButtonElement>(".nav-prev");
    const next = document.querySelector<HTMLButtonElement>(".nav-next");
    const currentLabel = document.querySelector<HTMLElement>(".counter-current");
    const totalLabel = document.querySelector<HTMLElement>(".counter-total");
    const filters = [...document.querySelectorAll<HTMLButtonElement>(".filter-btn")];
    let visible = all;
    let current = 0;
    let move: (direction: number) => void;

    const update = () => {
      all.forEach((slot) => slot.classList.remove("is-active"));
      visible[current]?.classList.add("is-active");
      if (currentLabel) currentLabel.textContent = String(current + 1);
      if (prev) prev.disabled = visible.length < 2;
      if (next) next.disabled = visible.length < 2;
    };

    move = (direction: number) => {
      if (visible.length > 1) {
        current = (current + direction + visible.length) % visible.length;
        update();
      }
    };

    prev?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";
        visible = all.filter((slot) => filter === "all" || slot.dataset.type === filter);
        all.forEach((slot) => slot.toggleAttribute("data-hidden", !visible.includes(slot)));
        filters.forEach((item) => {
          const chosen = item === button;
          item.classList.toggle("is-active", chosen);
          item.setAttribute("aria-selected", String(chosen));
        });
        current = 0;
        if (totalLabel) totalLabel.textContent = String(visible.length);
        update();
      });
    });

    document.addEventListener("keydown", (event) => {
      if ((event.target as HTMLElement)?.tagName === "INPUT") return;
      if (event.key === "ArrowLeft") move(-1);
      if (event.key === "ArrowRight") move(1);
    });

    update();
  }
</script>
