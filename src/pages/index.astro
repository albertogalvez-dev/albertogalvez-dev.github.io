---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AmbientBg from "../components/AmbientBg.astro";
import PhotosCarousel from "../components/PhotosCarousel.astro";
import TopNav from "../components/TopNav.astro";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Alberto Gálvez · Software Developer">
  <AmbientBg /><PhotosCarousel />
  <TopNav showProjects={false} />
  <main class="deck" id="projects">
    <p class="intro">FULL STACK DEVELOPER</p>
    <div class="deck-filter" role="tablist">
      <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true"><span data-en="All">Todos</span><b>{projects.length}</b></button>
      <button class="filter-btn" data-filter="personal" role="tab" aria-selected="false"><span data-en="Personal">Personales</span><b>{projects.filter(p => p.data.type === "Personal").length}</b></button>
      <button class="filter-btn" data-filter="cliente" role="tab" aria-selected="false"><span data-en="Company">Empresa</span><b>{projects.filter(p => p.data.type === "Cliente").length}</b></button>
    </div>
    <div class="deck-stage">
      {projects.map((project, index) => <div class:list={["deck-slot", {"is-active": index === 0}]} data-type={project.data.type === "Cliente" ? "cliente" : "personal"}><ProjectCard {...project.data} slug={project.id} /></div>)}
    </div>
    <nav class="deck-nav" aria-label="Navegar proyectos"><button class="nav-prev" aria-label="Proyecto anterior" disabled>‹</button><span><i class="counter-current">1</i> / <i class="counter-total">{projects.length}</i></span><button class="nav-next" aria-label="Siguiente proyecto">›</button></nav>
  </main>
</Layout>
<style is:global>
  html,body{overflow-x:hidden}body{background:#fafafa!important;color:#1a1a22!important;--ink:#1a1a22;--ink-muted:rgba(20,20,30,.55);--ink-soft:rgba(20,20,30,.78);--glass-border:rgba(0,0,0,.06);--glass-strong:rgba(0,0,0,.16)}.btn-primary{background:#1a1a22!important;color:#fafafa!important;border-color:#1a1a22!important}.btn-primary:hover{background:#34343d!important;color:#fafafa!important}
</style>
<style>
  .deck{display:grid;min-height:calc(100svh - 69px);box-sizing:border-box;place-items:center;align-content:center;gap:clamp(8px,1.5vh,14px);padding:32px 20px 40px}.intro{margin:0;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.28em;color:var(--ink-muted)}.deck-filter{display:flex;gap:4px;padding:4px;border:1px solid rgba(0,0,0,.06);border-radius:999px;background:rgba(255,255,255,.55);box-shadow:inset 0 1px rgba(255,255,255,.7),0 4px 14px rgba(20,18,40,.06);backdrop-filter:blur(18px)}.filter-btn{min-height:44px;justify-content:center;display:inline-flex;gap:8px;align-items:center;padding:7px 14px;border-radius:999px;color:rgba(20,20,30,.6);font-size:12px;font-weight:500}.filter-btn:hover{background:rgba(0,0,0,.04);color:var(--ink)}.filter-btn.is-active{background:#1a1a22;color:#fafafa}.filter-btn b{padding:2px 7px;border-radius:999px;background:rgba(0,0,0,.06);font-family:var(--mono);font-size:10px}.filter-btn.is-active b{background:rgba(255,255,255,.18)}.deck-stage{position:relative;display:grid;align-items:center;width:min(100%,480px);min-height:0}.deck-slot{grid-area:1/1;width:100%;display:none;animation:fade .38s cubic-bezier(.4,0,.2,1)}.deck-slot.is-active{display:block}.deck-slot[data-hidden]{display:none!important}@keyframes fade{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}.deck-nav{display:flex;gap:12px;align-items:center;color:var(--ink-muted);font-family:var(--mono);font-size:12px}.deck-nav button{display:grid;width:44px;height:44px;place-items:center;border:1px solid var(--glass-border);border-radius:999px;background:rgba(255,255,255,.04);color:var(--ink-soft);font-size:20px}.deck-nav button:hover:not(:disabled){background:rgba(255,255,255,.45);border-color:var(--glass-strong)}.deck-nav button:disabled{opacity:.3;cursor:not-allowed}.deck-nav span{min-width:54px;text-align:center}.deck-nav i{font-style:normal}@media(max-width:720px){.deck{gap:clamp(7px,1.2vh,11px);padding:28px 16px 40px}.deck-stage{min-height:0}.intro{font-size:10px;letter-spacing:.22em}.filter-btn{padding:10px 12px;font-size:13px}.deck-nav{gap:10px}.deck-nav button{width:44px;height:44px}}
  .deck-filter { flex-wrap: wrap; justify-content: center; max-width: 100%; }
  @media (max-width: 720px) { .deck-filter { border-radius: 24px; } .filter-btn { flex: 1 1 auto; } }
</style>
<script>
  const stage = document.querySelector<HTMLDivElement>(".deck-stage");
  if (stage) {
    const all = [...stage.querySelectorAll<HTMLDivElement>(".deck-slot")];
    const prev = document.querySelector<HTMLButtonElement>(".nav-prev");
    const next = document.querySelector<HTMLButtonElement>(".nav-next");
    const currentLabel = document.querySelector<HTMLElement>(".counter-current");
    const totalLabel = document.querySelector<HTMLElement>(".counter-total");
    const filters = [...document.querySelectorAll<HTMLButtonElement>(".filter-btn")];
    let visible = all;
    let current = 0;
    let move: (direction: number) => void;

    const update = () => {
      all.forEach((slot) => slot.classList.remove("is-active"));
      visible[current]?.classList.add("is-active");
      if (currentLabel) currentLabel.textContent = String(current + 1);
      if (prev) prev.disabled = visible.length < 2;
      if (next) next.disabled = visible.length < 2;
    };

    move = (direction: number) => {
      if (visible.length > 1) {
        current = (current + direction + visible.length) % visible.length;
        update();
      }
    };

    prev?.addEventListener("click", () => move(-1));
    next?.addEventListener("click", () => move(1));

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";
        visible = all.filter((slot) => filter === "all" || slot.dataset.type === filter);
        all.forEach((slot) => slot.toggleAttribute("data-hidden", !visible.includes(slot)));
        filters.forEach((item) => {
          const chosen = item === button;
          item.classList.toggle("is-active", chosen);
          item.setAttribute("aria-selected", String(chosen));
        });
        current = 0;
        if (totalLabel) totalLabel.textContent = String(visible.length);
        update();
      });
    });

    document.addEventListener("keydown", (event) => {
      if ((event.target as HTMLElement)?.tagName === "INPUT") return;
      if (event.key === "ArrowLeft") move(-1);
      if (event.key === "ArrowRight") move(1);
    });

    update();
  }
</script>
