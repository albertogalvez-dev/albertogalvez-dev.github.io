---

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = "Alberto Gálvez · Software Developer",
  description = "Alberto Gálvez Aguado — Full Stack Developer · Junior. Proyectos, trayectoria y CV.",
  ogImage: ogImageProp,
} = Astro.props;

const site = Astro.site ?? new URL("https://albertogalvez-dev.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(ogImageProp ?? "/social-card-v2.jpg", site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alberto Gálvez Aguado" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0c;
    --ink: #f5f5f7;
    --ink-muted: rgba(245, 245, 247, 0.6);
    --ink-soft: rgba(245, 245, 247, 0.85);
    --glass: rgba(20, 20, 22, 0.55);
    --glass-border: rgba(255, 255, 255, 0.08);
    --glass-strong: rgba(255, 255, 255, 0.16);
    --sans:
      "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      sans-serif;
    --mono:
      "JetBrains Mono", ui-monospace, "SF Mono", Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    min-height: 100%;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
</style>
