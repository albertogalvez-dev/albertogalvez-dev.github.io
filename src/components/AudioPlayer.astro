---
interface Props {
  src?: string;
  volume?: number;
}
const { src = "/audio/bg-music.mp3", volume = 0.32 } = Astro.props;
---

<div class="audio-player" data-volume={volume}>
  <audio
    id="bgAudio"
    src={src}
    loop
    preload="auto"
    aria-hidden="true"></audio>

  <button
    type="button"
    id="audioToggle"
    class="audio-btn"
    aria-label="Activar música de fondo"
    title="Activar música"
  >
    <!-- Icono OFF (default) -->
    <svg
      class="icon icon-off"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
      <line x1="22" y1="9" x2="16" y2="15"></line>
      <line x1="16" y1="9" x2="22" y2="15"></line>
    </svg>
    <!-- Icono ON (oculto por default) -->
    <svg
      class="icon icon-on"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
      <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    </svg>
    <span class="visualizer" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </span>
  </button>
</div>

<script>
  const audio = document.querySelector<HTMLAudioElement>("#bgAudio");
  const btn = document.querySelector<HTMLButtonElement>("#audioToggle");
  const wrap = document.querySelector<HTMLElement>(".audio-player");
  const STORAGE_KEY = "portfolio-music-enabled";

  if (audio && btn && wrap) {
    const targetVolume = Number(wrap.dataset.volume ?? "0.32");
    audio.volume = 0;
    let isOn = false;

    const fadeTo = (target: number, durationMs = 700) => {
      const start = audio.volume;
      const diff = target - start;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - t0) / durationMs, 1);
        audio.volume = Math.max(0, Math.min(1, start + diff * p));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const turnOn = async () => {
      try {
        await audio.play();
        fadeTo(targetVolume);
        btn.classList.add("is-on");
        btn.setAttribute("aria-label", "Silenciar música de fondo");
        btn.setAttribute("title", "Silenciar música");
        isOn = true;
        localStorage.setItem(STORAGE_KEY, "1");
      } catch (err) {
        console.warn("Audio play blocked:", err);
      }
    };

    const turnOff = () => {
      fadeTo(0, 400);
      window.setTimeout(() => audio.pause(), 420);
      btn.classList.remove("is-on");
      btn.setAttribute("aria-label", "Activar música de fondo");
      btn.setAttribute("title", "Activar música");
      isOn = false;
      localStorage.setItem(STORAGE_KEY, "0");
    };

    btn.addEventListener("click", () => {
      if (isOn) turnOff();
      else turnOn();
    });

    // Si el usuario activó música antes, no autoplay (browsers lo bloquean),
    // pero dejamos el botón visualmente "armed" para que con un click se active.
    if (localStorage.getItem(STORAGE_KEY) === "1") {
      btn.classList.add("is-armed");
      btn.setAttribute("title", "Click para reanudar música");
    }
  }
</script>

<style>
  .audio-player {
    position: fixed;
    right: clamp(20px, 3vw, 32px);
    bottom: clamp(20px, 3vw, 32px);
    z-index: 30;
  }

  .audio-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(20, 20, 22, 0.55);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: rgba(245, 245, 247, 0.7);
    cursor: pointer;
    transition:
      transform 200ms cubic-bezier(0.4, 0, 0.2, 1),
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .audio-btn:hover {
    transform: translateY(-2px);
    background: rgba(30, 30, 34, 0.7);
    border-color: rgba(255, 255, 255, 0.18);
    color: var(--ink, #f5f5f7);
  }

  .audio-btn.is-on {
    color: var(--ink, #f5f5f7);
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(30, 30, 34, 0.75);
  }

  .audio-btn.is-armed {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .icon {
    transition: opacity 200ms ease;
  }

  .icon-on {
    position: absolute;
    opacity: 0;
  }

  .audio-btn.is-on .icon-off {
    opacity: 0;
  }

  .audio-btn.is-on .icon-on {
    opacity: 1;
  }

  /* Visualizer 4 barras que pulsan cuando está activo */
  .visualizer {
    position: absolute;
    inset: auto auto -10px 50%;
    display: flex;
    gap: 2px;
    align-items: end;
    height: 8px;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .visualizer i {
    display: block;
    width: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .visualizer i:nth-child(1) {
    animation: bar 0.9s ease-in-out infinite;
  }
  .visualizer i:nth-child(2) {
    animation: bar 1.2s ease-in-out 0.15s infinite;
  }
  .visualizer i:nth-child(3) {
    animation: bar 0.85s ease-in-out 0.3s infinite;
  }
  .visualizer i:nth-child(4) {
    animation: bar 1.1s ease-in-out 0.45s infinite;
  }

  .audio-btn.is-on .visualizer {
    opacity: 0.85;
  }

  @keyframes bar {
    0%,
    100% {
      height: 2px;
    }
    50% {
      height: 7px;
    }
  }

  @media (max-width: 768px) {
    .audio-player {
      right: 14px;
      bottom: 14px;
    }
    .audio-btn {
      width: 40px;
      height: 40px;
    }
  }
</style>
