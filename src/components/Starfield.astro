---
// Starfield deep-space — canvas 2D performante.
// Cientos de estrellas flotando lento con depth y twinkle sutil.
interface Props {
  density?: number; // 0.5 (pocas) a 2 (muchas). Default 1.
}
const { density = 1 } = Astro.props;
---

<canvas id="starfield" class="starfield" data-density={density}></canvas>

<script>
  type Star = {
    x: number;
    y: number;
    z: number; // depth (0.1 = lejos, 1 = cerca)
    size: number;
    twinkleSpeed: number;
    twinklePhase: number;
  };

  const canvas = document.querySelector<HTMLCanvasElement>("#starfield");
  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const density = Number(canvas.dataset.density ?? "1");
    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let t = 0;

    const resize = () => {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.scale(dpr, dpr);

      // Densidad: ~1 estrella cada 8000px² al 1.0
      const count = Math.round((w * h) / 8000 * density);
      stars = [];
      for (let i = 0; i < count; i++) {
        const z = Math.random() * 0.9 + 0.1; // 0.1 a 1
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          z,
          size: z * 1.4 + 0.2, // las cercanas se ven más gordas
          twinkleSpeed: 0.0006 + Math.random() * 0.0014,
          twinklePhase: Math.random() * Math.PI * 2,
        });
      }
    };

    const draw = (now: number) => {
      if (!t) t = now;
      const dt = now - t;
      t = now;

      ctx.clearRect(0, 0, w, h);

      for (const s of stars) {
        // Drift muy lento horizontal según z (depth parallax)
        s.x += (s.z * 0.012) * dt;
        if (s.x > w + 4) s.x = -4;

        // Twinkle: opacity oscila sutil
        s.twinklePhase += s.twinkleSpeed * dt;
        const tw = (Math.sin(s.twinklePhase) + 1) * 0.5; // 0..1
        const alpha = 0.25 + tw * 0.55 * s.z;

        // Glow para las cercanas
        if (s.z > 0.7) {
          ctx.fillStyle = `rgba(220, 200, 255, ${alpha * 0.35})`;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size * 3, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
      }

      raf = requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);
    raf = requestAnimationFrame(draw);

    // Pausar cuando la pestaña no es visible
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else if (!raf) {
        t = 0;
        raf = requestAnimationFrame(draw);
      }
    });

    if (import.meta.hot) {
      import.meta.hot.dispose(() => {
        cancelAnimationFrame(raf);
        window.removeEventListener("resize", resize);
      });
    }
  }
</script>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: -8;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 40%,
        rgba(30, 18, 50, 0.45),
        transparent 70%
      ),
      linear-gradient(180deg, #05050b 0%, #030206 100%);
  }
</style>
