---
import type { ImageMetadata } from "astro";
import ProjectIcon from "./ProjectIcon.astro";

interface Props {
  title: string;
  tagline?: string;
  tagline_en?: string;
  type: string;
  type_en?: string;
  year: string;
  summary: string;
  summary_en?: string;
  stack: string[];
  cover?: ImageMetadata;
  gallery?: ImageMetadata[];
  logo?: string;
  repo?: string;
  demo?: string;
  logoIcon?: string;
  slug: string;
  accent?: string;
  accent2?: string;
}
const {
  title,
  tagline,
  tagline_en,
  type,
  type_en,
  year,
  summary,
  summary_en,
  stack,
  cover,
  gallery,
  logo,
  repo,
  demo,
  logoIcon,
  slug,
  accent,
  accent2,
} = Astro.props;
const cardStyle = [
  accent ? `--card-accent: ${accent};` : "",
  accent2 ? `--card-accent2: ${accent2};` : "",
]
  .filter(Boolean)
  .join(" ");

// Extract clean domain from demo URL for button label (e.g. "gallinasconflow.es")
function getDomain(url?: string): string | null {
  if (!url) return null;
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return null;
  }
}
const demoDomain = getDomain(demo);
---

<div class="card-wrap" style={cardStyle}>
<article class="card" tabindex="0">
  <!-- Overlay link — todo el card es clickable hacia el detalle.
       Los botones de abajo se posicionan con z-index encima para que sigan
       funcionando individualmente (repo abre repo, VER PROYECTO igual al overlay). -->
  <a class="card-link" href={`/projects/${slug}`} aria-label={`Ver proyecto ${title}`}>
    <span class="visually-hidden">Ver proyecto {title}</span>
  </a>

  <div class="card-logo">
    <div class="logo-mark" aria-hidden="true">
      {logo ? <img src={logo} alt="" /> : <ProjectIcon name={logoIcon} />}
    </div>
    <span class="logo-title">{title}</span>
    {tagline && <span class="logo-tagline" data-en={tagline_en || tagline}>{tagline}</span>}
  </div>

  <div class="card-body">
    <div class="meta">
      <span class="meta-type" data-en={type_en || type}>{type}</span>
      <span class="meta-year">{year}</span>
    </div>

    <p class="summary" data-en={summary_en || summary}>{summary}</p>

    <ul class="stack">
      {stack.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="actions">
      <a href={`/projects/${slug}`} class="btn-primary" data-en="VIEW PROJECT">
        VER PROYECTO
      </a>
      {
        demo && demoDomain && (
          <a
            href={demo}
            target="_blank"
            rel="noreferrer"
            class="btn-ghost"
            aria-label={`Abrir ${demoDomain}`}
          >
            <span class="btn-ghost-text">{demoDomain}</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M17 7H8M17 7V16"/>
            </svg>
          </a>
        )
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noreferrer"
            class="btn-secondary"
            data-en="REPO"
          >
            REPO
          </a>
        )
      }
    </div>
  </div>
</article>
</div>

<style>
  .card-wrap {
    width: min(100%, 560px);
  }

  /* Overlay link — cubre todo el card.
     z-index 2 — por encima del contenido (logos, body, halo) pero por debajo de .actions (z-index 3). */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
    text-decoration: none;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--card-accent, #888) 65%, var(--ink));
    outline-offset: 2px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .card {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.32);
    backdrop-filter: blur(52px) saturate(190%);
    -webkit-backdrop-filter: blur(52px) saturate(190%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04),
      0 1px 2px rgba(20, 18, 40, 0.04),
      0 30px 70px rgba(20, 18, 40, 0.18),
      0 12px 32px rgba(20, 18, 40, 0.1);
    cursor: pointer;
    transition:
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  /* Highlight superior brillo sutil tipo iOS */
  .card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.9),
      transparent
    );
    pointer-events: none;
    z-index: 2;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(
      in srgb,
      var(--card-accent, white) 35%,
      var(--glass-strong)
    );
    outline: none;
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.08) inset,
      0 40px 120px rgba(0, 0, 0, 0.6),
      0 12px 36px rgba(0, 0, 0, 0.4),
      0 0 0 1px
        color-mix(in srgb, var(--card-accent, white) 18%, transparent);
  }

  .card-logo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 56px 24px 48px;
    aspect-ratio: 16 / 11;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card-accent, white) 10%, rgba(255, 255, 255, 0.08)),
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 4%, transparent)
    );
    border-bottom: 1px solid var(--glass-border);
    text-align: center;
    overflow: hidden;
  }

  /* Soft glow halo behind the icon — tinted by accent2 (logo color) */
  .card-logo::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    height: 300px;
    transform: translate(-50%, -65%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 26%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
    filter: blur(22px);
  }

  .logo-mark {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 32%, rgba(255, 255, 255, 0.5));
    /* Cube icon uses the SECONDARY accent (logo color, e.g. green for WMS) */
    color: color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 82%, var(--ink));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 14px 36px color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 30%, transparent),
      0 3px 10px rgba(20, 18, 40, 0.09);
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .logo-mark img {
    display: block;
    width: 64px;
    height: 64px;
  }

  .card:hover .logo-mark,
  .card:focus-visible .logo-mark {
    transform: translateY(-2px) scale(1.02);
  }

  .logo-title {
    position: relative;
    z-index: 1;
    font-family: var(--sans);
    font-size: clamp(30px, 3.8vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin-top: 4px;
  }

  .logo-tagline {
    position: relative;
    z-index: 1;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-accent, white) 50%, var(--ink-muted));
    opacity: 0.9;
  }

  .card-body {
    padding: 26px 30px 30px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-type {
    padding: 5px 11px;
    border: 1px solid
      color-mix(in srgb, var(--card-accent, white) 28%, var(--glass-border));
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--card-accent, white) 14%,
      rgba(255, 255, 255, 0.04)
    );
    color: color-mix(in srgb, var(--card-accent, white) 65%, var(--ink));
  }

  .meta-year {
    color: var(--ink-muted);
  }

  .summary {
    margin: 0 0 22px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 5px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    position: relative;
    z-index: 3;
  }

  .btn-primary,
  .btn-secondary {
    padding: 11px 20px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition:
      transform 200ms ease,
      background 200ms ease;
  }

.btn-primary {
  background: var(--ink);
  color: #fafafa;
    border: 1px solid var(--ink);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: #34343d;
    color: #fafafa;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    border: 1px solid var(--glass-border);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Botón WEB — muestra el dominio real + icono de external link.
     Más concreto que "demo en vivo"; deja claro a qué URL vas. */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 16px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--card-accent, white) 8%, rgba(255, 255, 255, 0.05));
    border: 1px solid
      color-mix(in srgb, var(--card-accent, white) 24%, var(--glass-border));
    color: color-mix(in srgb, var(--card-accent, white) 70%, var(--ink));
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      transform 200ms ease,
      color 200ms ease;
  }
  .btn-ghost svg {
    opacity: 0.7;
    transition: transform 200ms ease, opacity 200ms ease;
  }
  .btn-ghost:hover {
    background: color-mix(in srgb, var(--card-accent, white) 14%, rgba(255, 255, 255, 0.08));
    border-color: color-mix(in srgb, var(--card-accent, white) 40%, var(--glass-border));
    color: color-mix(in srgb, var(--card-accent, white) 85%, var(--ink));
    transform: translateY(-1px);
  }
  .btn-ghost:hover svg {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* ============ MOBILE ADJUSTMENTS ============ */
  @media (max-width: 720px) {
    .card {
      border-radius: 22px;
    }

    /* Logo zone más compacta */
    .card-logo {
      padding: 36px 18px 28px;
      gap: 12px;
      aspect-ratio: auto;
    }
    .logo-mark {
      width: 72px;
      height: 72px;
      border-radius: 18px;
    }
    .logo-mark svg {
      width: 50px;
      height: 50px;
    }
    .logo-mark img {
      width: 52px;
      height: 52px;
    }
    .logo-title {
      font-size: clamp(24px, 7vw, 30px);
    }
    .logo-tagline {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
    .card-logo::after {
      width: 220px;
      height: 220px;
    }

    /* Body más compacto */
    .card-body {
      padding: 20px 22px 24px;
    }
    .meta {
      margin-bottom: 14px;
    }
    .summary {
      font-size: 14px;
      margin-bottom: 18px;
    }
    .stack {
      margin-bottom: 18px;
      gap: 5px;
    }
    .stack li {
      padding: 4px 9px;
      font-size: 10px;
    }

    /* Botones — más espacio para que respiren */
    .actions {
      gap: 6px;
    }
    .btn-primary,
    .btn-secondary,
    .btn-ghost {
      padding: 10px 14px;
      font-size: 11px;
    }
  }
</style>
