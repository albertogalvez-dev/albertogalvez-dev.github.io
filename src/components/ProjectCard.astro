---
import ProjectIcon from "./ProjectIcon.astro";
interface Props { title: string; logo?: string; logoIcon?: string; slug: string; demo?: string; accent?: string; accent2?: string; }
const { title, logo, logoIcon, slug, demo, accent = '#68738e', accent2 = accent } = Astro.props;
let domain = '';
try { if (demo) domain = new URL(demo).host.replace(/^www\./, ''); } catch {}
---
<article class="card" style={`--card-accent:${accent};--card-accent2:${accent2}`}>
  <a class="identity" href={`/projects/${slug}/`} aria-label={`Ver proyecto ${title}`}>
    <div class="logo-mark" aria-hidden="true">{logo ? <img src={logo} alt="" /> : <ProjectIcon name={logoIcon} />}</div>
    <h2>{title}</h2>
  </a>
  <div class="actions">
    <a class="project-link" href={`/projects/${slug}/`}><span data-en="View project">Ver proyecto</span><span aria-hidden="true">↗</span></a>
    {demo && domain && <a class="web-link" href={demo} target="_blank" rel="noreferrer" aria-label={`Abrir ${domain}`}><span>{domain}</span><span aria-hidden="true">↗</span></a>}
  </div>
</article>
<style>
.card{position:relative;width:100%;height:100%;min-height:0;display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(255,255,255,.65);border-radius:28px;background:rgba(255,255,255,.32);backdrop-filter:blur(52px) saturate(190%);-webkit-backdrop-filter:blur(52px) saturate(190%);box-shadow:inset 0 1px rgba(255,255,255,.85),0 24px 60px rgba(20,18,40,.16),0 8px 28px rgba(20,18,40,.09)}
.identity{position:relative;display:flex;flex:1 1 auto;min-height:0;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px 20px 12px;background:radial-gradient(ellipse at 50% 30%,color-mix(in srgb,var(--card-accent2) 14%,transparent),transparent 68%)}
.logo-mark{display:grid;place-items:center;width:78px;height:78px;flex-shrink:0;border-radius:23px;background:rgba(255,255,255,.78);border:1px solid rgba(255,255,255,.85);box-shadow:0 8px 28px color-mix(in srgb,var(--card-accent2) 23%,transparent),inset 0 1px white;transition:transform .22s ease}
.logo-mark img{display:block;width:60px;height:60px;object-fit:contain}.logo-mark :global(svg){width:54px;height:54px}.identity:hover .logo-mark{transform:translateY(-3px)}
.logo-mark img[src="/project-logos/bior.png"]{transform:scale(1.7)}
h2{margin:0;max-width:100%;text-align:center;overflow-wrap:anywhere;font:600 28px/1.1 var(--sans);letter-spacing:-.04em;color:var(--ink)}
.actions{flex:0 0 auto;display:flex;justify-content:center;align-items:center;gap:10px;padding:18px 20px 24px}
.actions a{display:inline-flex;justify-content:center;align-items:center;gap:12px;min-height:42px;padding:10px 17px;border-radius:999px;white-space:nowrap;transition:background .2s ease,transform .2s ease}
.project-link{background:#1a1a22;color:#fafafa;font:500 12px/1.2 var(--sans)}.project-link:hover{background:#34343d;transform:translateY(-1px)}.project-link>span:last-child{font-size:16px;font-weight:400;opacity:.8}
.web-link{border:1px solid color-mix(in srgb,var(--card-accent) 24%,transparent);background:rgba(255,255,255,.12);color:var(--ink-soft);font:500 10px/1.3 var(--mono);max-width:55%}.web-link>span:first-child{overflow:hidden;text-overflow:ellipsis}.web-link:hover{background:rgba(255,255,255,.32)}
@media(max-width:380px){.actions{padding:16px 14px 20px;gap:8px}.actions a{padding:10px 13px;gap:8px}.project-link{font-size:11px}.web-link{font-size:9px}}
@container(max-height:240px){.identity{flex-direction:row;gap:16px;padding:18px 20px 6px}.logo-mark{width:60px;height:60px;border-radius:18px}.logo-mark img{width:46px;height:46px}h2{font-size:25px}.actions{padding:12px 16px 18px}}
</style>
