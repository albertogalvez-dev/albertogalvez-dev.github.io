---
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  tagline?: string;
  tagline_en?: string;
  type: string;
  type_en?: string;
  year: string;
  summary: string;
  summary_en?: string;
  stack: string[];
  cover?: ImageMetadata;
  gallery?: ImageMetadata[];
  repo?: string;
  slug: string;
  accent?: string;
  accent2?: string;
}
const {
  title,
  tagline,
  tagline_en,
  type,
  type_en,
  year,
  summary,
  summary_en,
  stack,
  cover,
  gallery,
  repo,
  slug,
  accent,
  accent2,
} = Astro.props;
const cardStyle = [
  accent ? `--card-accent: ${accent};` : "",
  accent2 ? `--card-accent2: ${accent2};` : "",
]
  .filter(Boolean)
  .join(" ");
---

<div class="card-wrap" style={cardStyle}>
<article class="card" tabindex="0">
  <!-- Overlay link — todo el card es clickable hacia el detalle.
       Los botones de abajo se posicionan con z-index encima para que sigan
       funcionando individualmente (repo abre repo, VER PROYECTO igual al overlay). -->
  <a class="card-link" href={`/projects/${slug}`} aria-label={`Ver proyecto ${title}`}>
    <span class="visually-hidden">Ver proyecto {title}</span>
  </a>

  <div class="card-logo">
    <div class="logo-mark" aria-hidden="true">
      <svg width="62" height="62" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <!-- Top face (brightest fill) -->
        <path d="M8 18 L32 6 L56 18 L32 30 Z" fill="currentColor" fill-opacity="0.28"/>
        <!-- Left face (medium fill) -->
        <path d="M8 18 L8 46 L32 58 L32 30 Z" fill="currentColor" fill-opacity="0.14"/>
        <!-- Right face (subtle fill) -->
        <path d="M56 18 L56 46 L32 58 L32 30 Z" fill="currentColor" fill-opacity="0.06"/>
        <!-- Strong cube outline -->
        <path d="M32 6 L56 18 L56 46 L32 58 L8 46 L8 18 Z" stroke-width="2.8"/>
        <!-- Top diamond seams -->
        <path d="M8 18 L32 30 L56 18"/>
        <!-- Center vertical seam -->
        <line x1="32" y1="30" x2="32" y2="58"/>
        <!-- Internal "shelf" lines (subtle WMS touch — suggests storage compartments) -->
        <line x1="8" y1="32" x2="32" y2="44" stroke-width="1.6" opacity="0.42"/>
        <line x1="56" y1="32" x2="32" y2="44" stroke-width="1.6" opacity="0.42"/>
      </svg>
    </div>
    <span class="logo-title">{title}</span>
    {tagline && <span class="logo-tagline" data-en={tagline_en || tagline}>{tagline}</span>}
  </div>

  <div class="card-body">
    <div class="meta">
      <span class="meta-type" data-en={type_en || type}>{type}</span>
      <span class="meta-year">{year}</span>
    </div>

    <p class="summary" data-en={summary_en || summary}>{summary}</p>

    <ul class="stack">
      {stack.map((tech) => <li>{tech}</li>)}
    </ul>

    <div class="actions">
      <a href={`/projects/${slug}`} class="btn-primary" data-en="VIEW PROJECT">
        VER PROYECTO
      </a>
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noreferrer"
            class="btn-secondary"
            data-en="REPO"
          >
            REPO
          </a>
        )
      }
    </div>
  </div>
</article>
</div>

<style>
  .card-wrap {
    width: min(100%, 560px);
  }

  /* Overlay link — cubre todo el card, z-index 1.
     Los .actions van con z-index 2 para que el repo y VER PROYECTO sigan funcionando. */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
    text-decoration: none;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--card-accent, #888) 65%, var(--ink));
    outline-offset: 2px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .card {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.32);
    backdrop-filter: blur(52px) saturate(190%);
    -webkit-backdrop-filter: blur(52px) saturate(190%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(0, 0, 0, 0.04),
      0 1px 2px rgba(20, 18, 40, 0.04),
      0 30px 70px rgba(20, 18, 40, 0.18),
      0 12px 32px rgba(20, 18, 40, 0.1);
    cursor: pointer;
    transition:
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms ease,
      box-shadow 400ms ease;
  }

  /* Highlight superior brillo sutil tipo iOS */
  .card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.9),
      transparent
    );
    pointer-events: none;
    z-index: 2;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(
      in srgb,
      var(--card-accent, white) 35%,
      var(--glass-strong)
    );
    outline: none;
    box-shadow:
      0 1px 1px rgba(255, 255, 255, 0.08) inset,
      0 40px 120px rgba(0, 0, 0, 0.6),
      0 12px 36px rgba(0, 0, 0, 0.4),
      0 0 0 1px
        color-mix(in srgb, var(--card-accent, white) 18%, transparent);
  }

  .card-logo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 56px 24px 48px;
    aspect-ratio: 16 / 11;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card-accent, white) 10%, rgba(255, 255, 255, 0.08)),
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 4%, transparent)
    );
    border-bottom: 1px solid var(--glass-border);
    text-align: center;
    overflow: hidden;
  }

  /* Soft glow halo behind the icon — tinted by accent2 (logo color) */
  .card-logo::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    height: 300px;
    transform: translate(-50%, -65%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 26%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
    filter: blur(22px);
  }

  .logo-mark {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid
      color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 32%, rgba(255, 255, 255, 0.5));
    /* Cube icon uses the SECONDARY accent (logo color, e.g. green for WMS) */
    color: color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 82%, var(--ink));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 14px 36px color-mix(in srgb, var(--card-accent2, var(--card-accent, white)) 30%, transparent),
      0 3px 10px rgba(20, 18, 40, 0.09);
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover .logo-mark,
  .card:focus-visible .logo-mark {
    transform: translateY(-2px) scale(1.02);
  }

  .logo-title {
    position: relative;
    z-index: 1;
    font-family: var(--sans);
    font-size: clamp(30px, 3.8vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
    margin-top: 4px;
  }

  .logo-tagline {
    position: relative;
    z-index: 1;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-accent, white) 50%, var(--ink-muted));
    opacity: 0.9;
  }

  .card-body {
    padding: 26px 30px 30px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-type {
    padding: 5px 11px;
    border: 1px solid
      color-mix(in srgb, var(--card-accent, white) 28%, var(--glass-border));
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--card-accent, white) 14%,
      rgba(255, 255, 255, 0.04)
    );
    color: color-mix(in srgb, var(--card-accent, white) 65%, var(--ink));
  }

  .meta-year {
    color: var(--ink-muted);
  }

  .summary {
    margin: 0 0 22px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 5px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    gap: 8px;
    position: relative;
    z-index: 2;
  }

  .btn-primary,
  .btn-secondary {
    padding: 11px 20px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition:
      transform 200ms ease,
      background 200ms ease;
  }

  .btn-primary {
    background: var(--ink);
    color: #0a0a0c;
    border: 1px solid var(--ink);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: #fff;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    border: 1px solid var(--glass-border);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }
</style>
