---
import LangToggle from "./LangToggle.astro";

interface Props {
  showProjects?: boolean;
  showAbout?: boolean;
  showCv?: boolean;
}

const { showProjects = true, showAbout = true, showCv = true } = Astro.props;
---

<header class="topbar">
  <div class="topbar-left">
    <a class="brand" href="/" aria-label="Inicio">ag</a>
    {showProjects && <a class="nav-link" href="/#projects" data-en="projects">proyectos</a>}
    {showAbout && <a class="nav-link" href="/about/" data-en="about">sobre mí</a>}
  </div>

  <nav class="links" aria-label="Enlaces">
    <a href="https://github.com/albertogalvez-dev" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
    </a>
    <a href="https://www.linkedin.com/in/alberto-galvez-aguado/" target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-12h4v2z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
    </a>
    <a href="mailto:albertogalvezde0@gmail.com" aria-label="Email" title="Email">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
    </a>
    {showCv && <a class="cv-link" href="/cv/">cv</a>}
    <LangToggle />
  </nav>
</header>

<style>
  .topbar { position: fixed; inset: 0 0 auto; z-index: 20; display: flex; align-items: center; justify-content: space-between; padding: 24px clamp(20px, 5vw, 56px); pointer-events: none; }
  .topbar-left, .brand, .nav-link, .links a { pointer-events: auto; }
  .topbar-left, .links { display: flex; align-items: center; }
  .topbar-left { gap: 22px; }
  .brand, .nav-link { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: .18em; text-transform: lowercase; color: var(--ink-muted); }
  .brand { color: var(--ink-soft); }
  .nav-link { position: relative; padding: 4px 0; }
  .nav-link::after { content: ""; position: absolute; inset: auto 0 0; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .28s; }
  .nav-link:hover::after { transform: scaleX(1); }
  .links { gap: 18px; }
  .links a { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 999px; color: var(--ink-muted); transition: .2s; }
  .links a:hover { background: rgba(0, 0, 0, .05); color: var(--ink); transform: translateY(-1px); }
  .links .cv-link { width: auto; height: auto; padding: 0 3px; font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: lowercase; }
  @media (max-width: 720px) {
    .topbar { padding: 18px 14px; }
    .topbar-left { gap: 14px; }
    .links { gap: 8px; }
    .links a { width: 32px; height: 32px; }
    .links svg { width: 18px; height: 18px; }
    .links .cv-link { width: auto; height: auto; }
  }
  @media (max-width: 520px) {
    .topbar-left { gap: 10px; }
    .brand, .nav-link { font-size: 10px; letter-spacing: .11em; }
    .links { gap: 3px; }
    .links a { width: 28px; height: 28px; }
    .links svg { width: 16px; height: 16px; }
  }
  @media (max-width: 360px) {
    .topbar { padding-right: 10px; padding-left: 10px; }
    .topbar-left { gap: 7px; }
    .brand, .nav-link { font-size: 9px; letter-spacing: .055em; white-space: nowrap; }
    .links { gap: 2px; }
    .links a { width: 25px; height: 25px; }
    .links svg { width: 15px; height: 15px; }
    .links .cv-link { font-size: 10px; }
  }
</style>
