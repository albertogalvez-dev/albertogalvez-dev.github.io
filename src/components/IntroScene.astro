---
interface Props {
  splineUrl?: string;
}
const {
  splineUrl = "https://my.spline.design/nexbotrobotcharacterconcept-Dhbrp9wLMXoOSapAs91OdecB/",
} = Astro.props;
---

<div id="intro" class="intro" data-state="idle">
  <!-- ESCENA 3D -->
  <div class="scene-wrap">
    <iframe
      src={splineUrl}
      class="spline-stage"
      title="3D Scene"
      loading="eager"
      allow="autoplay; fullscreen"
      frameborder="0"></iframe>
    <span class="spline-mask" aria-hidden="true"></span>
  </div>

  <!-- CHEST MARK + BOTÓN ENTRAR -->
  <div class="chest-block">
    <span class="chest-mark" aria-hidden="true">ag</span>
    <button id="ctaEnter" class="enter-btn" type="button">
      <span class="enter-text" data-en="Enter">Entrar</span>
      <span class="enter-line" aria-hidden="true"></span>
      <span class="enter-arrow" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </button>
  </div>

  <!-- ESQUINAS HUD -->
  <div class="corners" aria-hidden="true">
    <span class="corner corner-tl"></span>
    <span class="corner corner-tr"></span>
    <span class="corner corner-bl"></span>
    <span class="corner corner-br"></span>
  </div>

  <!-- SPLASH INICIAL -->
  <button id="ctaStart" class="splash" type="button" aria-label="Empezar experiencia">
    <span class="splash-title">BEGIN</span>
    <span class="splash-line"></span>
  </button>

  <!-- VIGNETTE -->
  <div class="intro-vignette" aria-hidden="true"></div>

  <!-- FLASH BLANCO + FADE NEGRO -->
  <div id="introFlash" class="intro-flash" aria-hidden="true"></div>
  <div id="introFade" class="intro-fade" aria-hidden="true"></div>
</div>

<script>
  const intro = document.querySelector<HTMLElement>("#intro");
  const ctaStart = document.querySelector<HTMLButtonElement>("#ctaStart");
  const ctaEnter = document.querySelector<HTMLButtonElement>("#ctaEnter");
  const fade = document.querySelector<HTMLElement>("#introFade");
  const flash = document.querySelector<HTMLElement>("#introFlash");
  const audio = document.querySelector<HTMLAudioElement>("#bgAudio");

  const fadeVolume = (
    el: HTMLAudioElement,
    target: number,
    durationMs = 1200
  ) => {
    const start = el.volume;
    const diff = target - start;
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - t0) / durationMs, 1);
      el.volume = Math.max(0, Math.min(1, start + diff * p));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (intro && ctaStart && ctaEnter && fade && flash && audio) {
    audio.volume = 0;

    ctaStart.addEventListener(
      "click",
      async () => {
        try {
          await audio.play();
          fadeVolume(audio, 0.42, 1300);
        } catch (e) {
          console.warn("Audio blocked:", e);
        }
        intro.setAttribute("data-state", "playing");

        // Chest reveal a T=9s — más tiempo para escuchar la música y vivir la animación
        window.setTimeout(() => {
          intro.setAttribute("data-state", "reveal");
        }, 9000);
      },
      { once: true }
    );

    ctaEnter.addEventListener(
      "click",
      () => {
        // Transición "guapa": zoom forward del robot + flash blanco + fade negro
        intro.setAttribute("data-state", "leaving");
        // Flash blanco rápido
        flash.classList.add("is-flashing");
        window.setTimeout(() => {
          flash.classList.remove("is-flashing");
        }, 700);
        // Fade negro encima
        fadeVolume(audio, 0, 900);
        window.setTimeout(() => {
          fade.classList.add("is-fading");
        }, 350);
        window.setTimeout(() => {
          audio.pause();
          localStorage.setItem("portfolio-music-enabled", "0");
          window.location.href = "/deck/";
        }, 1300);
      },
      { once: true }
    );
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #030206;
    color: #f5f5f7;
    font-family: var(--sans, system-ui);
  }

  /* === ESCENA 3D === */
  .scene-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: scale(1.7);
    opacity: 0;
    transition:
      transform 12000ms cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 1400ms ease-out,
      filter 800ms ease-out;
  }
  .intro[data-state="playing"] .scene-wrap,
  .intro[data-state="reveal"] .scene-wrap {
    opacity: 1;
    transform: scale(0.92);
  }
  /* AL ENTRAR: zoom forward fuerte como si te tragase el robot */
  .intro[data-state="leaving"] .scene-wrap {
    opacity: 1;
    transform: scale(2.8);
    filter: brightness(1.3) saturate(1.2);
    transition:
      transform 1200ms cubic-bezier(0.55, 0, 0.45, 1),
      filter 900ms ease-in,
      opacity 900ms ease-in;
  }

  .spline-stage {
    width: 100vw;
    height: 100vh;
    display: block;
    border: 0;
  }

  .spline-mask {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 200px;
    height: 56px;
    background: linear-gradient(
      135deg,
      transparent 0%,
      transparent 30%,
      #030206 60%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* === CHEST BLOCK === */
  .chest-block {
    position: absolute;
    top: 58%;
    left: 50%;
    z-index: 5;
    display: grid;
    place-items: center;
    gap: 32px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  /* "ag" estilo brand del deck (mono lowercase) pero ampliado */
  .chest-mark {
    font-family: var(--mono, monospace);
    font-size: clamp(40px, 6vw, 78px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.92);
    text-shadow:
      0 0 30px rgba(200, 170, 255, 0.55),
      0 0 70px rgba(160, 120, 255, 0.3),
      0 2px 2px rgba(0, 0, 0, 0.7);
    padding-left: 0.18em; /* compensar letter-spacing visual */
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 900ms cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 1100ms cubic-bezier(0.22, 0.61, 0.36, 1);
    animation: chest-glow 3s ease-in-out infinite;
  }
  .intro[data-state="reveal"] .chest-mark {
    opacity: 1;
    transform: translateY(0);
  }
  .intro[data-state="leaving"] .chest-mark {
    opacity: 0;
    transform: scale(1.3);
    transition: all 500ms ease-in;
  }

  @keyframes chest-glow {
    0%, 100% {
      text-shadow:
        0 0 30px rgba(200, 170, 255, 0.55),
        0 0 70px rgba(160, 120, 255, 0.3),
        0 2px 2px rgba(0, 0, 0, 0.7);
    }
    50% {
      text-shadow:
        0 0 42px rgba(220, 190, 255, 0.85),
        0 0 100px rgba(180, 140, 255, 0.5),
        0 2px 2px rgba(0, 0, 0, 0.7);
    }
  }

  /* === BOTÓN ENTRAR (rediseñado más Apple) === */
  .enter-btn {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 4px 18px;
    border: 0;
    background: none;
    color: rgba(245, 245, 247, 0.92);
    cursor: pointer;
    font-family: var(--sans, "Inter", sans-serif);
    font-size: clamp(15px, 1.4vw, 17px);
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 1000ms cubic-bezier(0.22, 0.61, 0.36, 1) 2200ms,
      transform 1300ms cubic-bezier(0.22, 0.61, 0.36, 1) 2200ms,
      color 250ms ease;
  }
  .intro[data-state="reveal"] .enter-btn {
    opacity: 1;
    transform: translateY(0);
  }
  .intro[data-state="leaving"] .enter-btn {
    opacity: 0;
    transition:
      opacity 350ms ease,
      transform 350ms ease;
  }

  .enter-btn:hover {
    color: #fff;
  }

  .enter-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: rgba(245, 245, 247, 0.4);
    transform-origin: left center;
    transform: scaleX(0.4);
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .enter-btn:hover .enter-line {
    transform: scaleX(1);
    background: rgba(255, 255, 255, 0.7);
  }

  .enter-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .enter-btn:hover .enter-arrow {
    transform: translateX(6px);
  }

  /* === SPLASH INICIAL — "BEGIN" === */
  .splash {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    background: radial-gradient(
      ellipse 70% 50% at 50% 50%,
      rgba(35, 18, 60, 0.55),
      #030206 75%
    );
    border: 0;
    cursor: pointer;
    color: #f5f5f7;
    font-family: var(--sans, "Inter", sans-serif);
    transition:
      opacity 700ms ease,
      visibility 700ms ease;
    overflow: hidden;
  }
  .intro[data-state="playing"] .splash,
  .intro[data-state="reveal"] .splash,
  .intro[data-state="leaving"] .splash {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-title {
    position: relative;
    font-family: var(--sans, "Inter", sans-serif);
    font-size: clamp(64px, 10vw, 128px);
    font-weight: 700;
    letter-spacing: 0.42em;
    color: rgba(245, 245, 247, 0.95);
    text-shadow:
      0 0 32px rgba(200, 170, 255, 0.35),
      0 0 80px rgba(160, 120, 255, 0.18);
    padding-left: 0.42em; /* compensa letter-spacing visual */
    animation: title-breathe 3.6s ease-in-out infinite;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .splash:hover .splash-title {
    transform: scale(1.03);
    text-shadow:
      0 0 48px rgba(220, 190, 255, 0.6),
      0 0 120px rgba(180, 140, 255, 0.3);
  }

  @keyframes title-breathe {
    0%, 100% {
      text-shadow:
        0 0 32px rgba(200, 170, 255, 0.35),
        0 0 80px rgba(160, 120, 255, 0.18);
    }
    50% {
      text-shadow:
        0 0 44px rgba(220, 190, 255, 0.55),
        0 0 110px rgba(180, 140, 255, 0.28);
    }
  }

  .splash-line {
    position: absolute;
    left: 50%;
    bottom: 22%;
    width: 140px;
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.35),
      transparent
    );
    animation: line-scan 3.6s ease-in-out infinite;
  }

  @keyframes line-scan {
    0%, 100% {
      opacity: 0.4;
      width: 100px;
    }
    50% {
      opacity: 0.9;
      width: 180px;
    }
  }

  /* === ESQUINAS HUD === */
  .corners {
    position: absolute;
    inset: 28px;
    z-index: 4;
    pointer-events: none;
  }
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    opacity: 0;
    transition: opacity 1400ms ease;
  }
  .intro[data-state="playing"] .corner,
  .intro[data-state="reveal"] .corner,
  .intro[data-state="leaving"] .corner {
    opacity: 1;
  }
  .corner-tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
  .corner-tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
  .corner-bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
  .corner-br { bottom: 0; right: 0; border-left: 0; border-top: 0; }

  /* === VIGNETTE === */
  .intro-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at center,
        transparent 38%,
        rgba(0, 0, 0, 0.55) 100%
      ),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.4) 0%,
        transparent 22%,
        transparent 78%,
        rgba(0, 0, 0, 0.5) 100%
      );
  }

  /* === FLASH BLANCO === */
  .intro-flash {
    position: absolute;
    inset: 0;
    z-index: 99;
    background:
      radial-gradient(
        circle at center,
        rgba(255, 255, 255, 0.85),
        rgba(255, 255, 255, 0) 70%
      );
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease-out;
  }
  .intro-flash.is-flashing {
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  /* === FADE NEGRO === */
  .intro-fade {
    position: absolute;
    inset: 0;
    z-index: 100;
    background: #030206;
    opacity: 0;
    pointer-events: none;
    transition: opacity 950ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .intro-fade.is-fading {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-wrap { transition: opacity 400ms ease; transform: scale(1); }
    .chest-mark, .enter-btn { transition: opacity 400ms ease; }
    .splash-title, .splash-line { animation: none; }
  }
</style>
