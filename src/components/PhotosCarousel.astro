---
// Carrusel de fotos en background. Crossfade lento entre las imágenes.
// Sobre el AmbientBg, debajo del contenido. Opacity baja para que se mezcle.
const photos = [
  "/photos/photo-1.jpg",
  "/photos/photo-2.jpg",
  "/photos/aircury-summer-of-code.jpg",
];
const photoStep = 11;
const cycle = photos.length * photoStep;
---

<div class="photos-carousel" aria-hidden="true">
  {
    photos.map((src, i) => (
      <img
        src={src}
        alt=""
        class="photo"
        style={`animation-delay: ${i * photoStep}s; animation-duration: ${cycle}s;`}
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    ))
  }
  <div class="photos-tint"></div>
  <div class="photos-vignette"></div>
</div>

<style>
  .photos-carousel {
    position: fixed;
    inset: 0;
    z-index: -8;
    overflow: hidden;
    pointer-events: none;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.03);
    filter: saturate(0.95) contrast(1.04) brightness(1.02);
    animation: photo-cycle 14s ease-in-out infinite;
    will-change: opacity, transform;
  }

  /* Ciclo: cada foto visible ~50% del tiempo, crossfade entre ellas.
     Sin zoom exagerado — solo un drift muy sutil. */
  @keyframes photo-cycle {
    0%   { opacity: 0; transform: scale(1.05); }
    14%  { opacity: 0.45; transform: scale(1.03); }
    36%  { opacity: 0.45; transform: scale(1); }
    50%  { opacity: 0; transform: scale(0.99); }
    100% { opacity: 0; transform: scale(0.99); }
  }

  /* Velo blanco MUY ligero — para que la card glass tenga algo que difuminar */
  .photos-tint {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 65% at 50% 55%,
      rgba(250, 250, 252, 0.4) 0%,
      rgba(250, 250, 252, 0.18) 50%,
      rgba(250, 250, 252, 0.02) 100%
    );
  }

  .photos-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(250, 250, 252, 0.5) 0%,
        rgba(250, 250, 252, 0) 18%,
        rgba(250, 250, 252, 0) 82%,
        rgba(250, 250, 252, 0.6) 100%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    .photo {
      animation: none;
      opacity: 0.18;
    }
  }
</style>
