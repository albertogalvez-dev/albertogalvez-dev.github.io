---
// Project icon set — un SVG distinto por proyecto.
// Todos los iconos usan currentColor para tintarse con el accent2 del card.
// viewBox 0 0 64 64 unificado; stroke-width consistente.
interface Props {
  name?: string;
  size?: number;
}
const { name = "box", size = 62 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* ===== BOX / CUBE (WMS) — caja isométrica con estanterías internas ===== */}
  {name === "box" && (
    <>
      <path d="M8 18 L32 6 L56 18 L32 30 Z" fill="currentColor" fill-opacity="0.28"/>
      <path d="M8 18 L8 46 L32 58 L32 30 Z" fill="currentColor" fill-opacity="0.14"/>
      <path d="M56 18 L56 46 L32 58 L32 30 Z" fill="currentColor" fill-opacity="0.06"/>
      <path d="M32 6 L56 18 L56 46 L32 58 L8 46 L8 18 Z" stroke-width="2.8"/>
      <path d="M8 18 L32 30 L56 18"/>
      <line x1="32" y1="30" x2="32" y2="58"/>
      <line x1="8" y1="32" x2="32" y2="44" stroke-width="1.6" opacity="0.42"/>
      <line x1="56" y1="32" x2="32" y2="44" stroke-width="1.6" opacity="0.42"/>
    </>
  )}

  {/* ===== MAP-PIN (Servicios GRX — directorio local) ===== */}
  {name === "map-pin" && (
    <>
      <path d="M32 6 C20 6 12 14 12 26 C12 38 24 50 32 58 C40 50 52 38 52 26 C52 14 44 6 32 6 Z" fill="currentColor" fill-opacity="0.18" stroke-width="2.6"/>
      <circle cx="32" cy="26" r="7" fill="currentColor" fill-opacity="0.6"/>
      <circle cx="32" cy="26" r="7" stroke-width="2.4"/>
    </>
  )}

  {/* ===== TOOTH (Dentista Guadix) — diente estilizado ===== */}
  {name === "tooth" && (
    <>
      <path d="M22 8 C26 6 30 8 32 12 C34 8 38 6 42 8 C48 10 50 16 49 22 C48 28 46 32 44 36 C42 40 41 44 40 50 C39 54 37 56 35 54 C33 52 32 48 31 42 C30 38 28 38 27 42 C26 48 25 52 23 54 C21 56 19 54 18 50 C17 44 16 40 14 36 C12 32 10 28 9 22 C8 16 10 10 16 8 C18 7 20 7 22 8 Z" fill="currentColor" fill-opacity="0.2" stroke-width="2.6"/>
    </>
  )}

  {/* ===== EGG (Gallinas con Flow) — huevo con líneas de "fresco" ===== */}
  {name === "egg" && (
    <>
      <path d="M32 6 C22 6 14 18 14 34 C14 46 22 56 32 56 C42 56 50 46 50 34 C50 18 42 6 32 6 Z" fill="currentColor" fill-opacity="0.22" stroke-width="2.6"/>
      <path d="M24 22 Q24 14 30 12" stroke-width="1.6" opacity="0.55"/>
      <path d="M26 28 Q26 22 30 20" stroke-width="1.6" opacity="0.45"/>
    </>
  )}

  {/* ===== MEGAPHONE (Sempatiza — agencia marketing) ===== */}
  {name === "megaphone" && (
    <>
      <path d="M44 14 L20 28 L20 36 L44 50 Z" fill="currentColor" fill-opacity="0.2" stroke-width="2.6"/>
      <rect x="10" y="26" width="10" height="12" rx="2" fill="currentColor" fill-opacity="0.12" stroke-width="2.4"/>
      <path d="M50 22 Q56 32 50 42" stroke-width="2.2"/>
      <path d="M24 38 L24 52 Q24 56 28 56 L30 56 Q34 56 34 52 L34 41" stroke-width="2.2"/>
    </>
  )}

  {/* ===== PAW (Guía Canina) — huella canina ===== */}
  {name === "paw" && (
    <>
      <ellipse cx="32" cy="44" rx="12" ry="10" fill="currentColor" fill-opacity="0.22" stroke-width="2.6"/>
      <ellipse cx="16" cy="30" rx="5" ry="6" fill="currentColor" fill-opacity="0.22" stroke-width="2.4"/>
      <ellipse cx="48" cy="30" rx="5" ry="6" fill="currentColor" fill-opacity="0.22" stroke-width="2.4"/>
      <ellipse cx="24" cy="18" rx="4" ry="5" fill="currentColor" fill-opacity="0.22" stroke-width="2.4"/>
      <ellipse cx="40" cy="18" rx="4" ry="5" fill="currentColor" fill-opacity="0.22" stroke-width="2.4"/>
    </>
  )}

  {/* ===== TICKET (Helpdesk MVP) — ticket con notch ===== */}
  {name === "ticket" && (
    <>
      <path d="M8 18 L8 28 Q14 28 14 32 Q14 36 8 36 L8 46 L56 46 L56 36 Q50 36 50 32 Q50 28 56 28 L56 18 Z" fill="currentColor" fill-opacity="0.18" stroke-width="2.6"/>
      <line x1="22" y1="24" x2="22" y2="40" stroke-width="1.6" opacity="0.45" stroke-dasharray="2 3"/>
      <line x1="30" y1="28" x2="44" y2="28" stroke-width="1.6" opacity="0.55"/>
      <line x1="30" y1="36" x2="40" y2="36" stroke-width="1.6" opacity="0.45"/>
    </>
  )}

  {/* ===== USERS (QUEUE — cola de gente) ===== */}
  {name === "users" && (
    <>
      <circle cx="32" cy="16" r="6" fill="currentColor" fill-opacity="0.22" stroke-width="2.5"/>
      <path d="M20 32 Q20 24 32 24 Q44 24 44 32" stroke-width="2.5"/>
      <circle cx="14" cy="22" r="4" fill="currentColor" fill-opacity="0.18" stroke-width="2.2"/>
      <circle cx="50" cy="22" r="4" fill="currentColor" fill-opacity="0.18" stroke-width="2.2"/>
      <path d="M6 36 Q6 30 14 30" stroke-width="2.2"/>
      <path d="M58 36 Q58 30 50 30" stroke-width="2.2"/>
      <line x1="12" y1="46" x2="52" y2="46" stroke-width="2" opacity="0.4"/>
      <line x1="14" y1="52" x2="50" y2="52" stroke-width="2" opacity="0.3"/>
    </>
  )}

  {/* ===== CLIPBOARD (Field Report Pro — informes campo) ===== */}
  {name === "clipboard" && (
    <>
      <rect x="12" y="14" width="40" height="46" rx="4" fill="currentColor" fill-opacity="0.15" stroke-width="2.6"/>
      <rect x="22" y="8" width="20" height="10" rx="2" fill="currentColor" fill-opacity="0.3" stroke-width="2.4"/>
      <line x1="20" y1="30" x2="44" y2="30" stroke-width="1.8" opacity="0.5"/>
      <line x1="20" y1="38" x2="44" y2="38" stroke-width="1.8" opacity="0.5"/>
      <line x1="20" y1="46" x2="36" y2="46" stroke-width="1.8" opacity="0.5"/>
      <path d="M20 22 L23 25 L28 20" stroke-width="2.2" opacity="0.7"/>
    </>
  )}

  {/* ===== PEN (Trazo — herramienta de dibujo IA) ===== */}
  {name === "pen" && (
    <>
      <path d="M46 6 L58 18 L24 52 L12 52 L12 40 Z" fill="currentColor" fill-opacity="0.2" stroke-width="2.6"/>
      <line x1="42" y1="10" x2="54" y2="22" stroke-width="2.4"/>
      <path d="M12 52 L18 46" stroke-width="2.2"/>
      {/* Sparkle/IA detail */}
      <circle cx="52" cy="40" r="2" fill="currentColor" stroke-width="0"/>
      <line x1="50" y1="34" x2="50" y2="38" stroke-width="1.4" opacity="0.6"/>
      <line x1="54" y1="42" x2="58" y2="42" stroke-width="1.4" opacity="0.6"/>
      <line x1="46" y1="42" x2="48" y2="42" stroke-width="1.4" opacity="0.6"/>
    </>
  )}
</svg>
